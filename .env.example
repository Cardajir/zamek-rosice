# Copy to .env. Both values are public: they ship in the client bundle.
# Leave the project id empty to run the site without a CMS.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Site key of the Cloudflare Turnstile widget on the contact form. Public.
# Leave empty to show the form without a challenge.
PUBLIC_TURNSTILE_SITE_KEY=

# Secrets for the contact form (same places as the ones below). Until
# RESEND_API_KEY and CONTACT_FROM are set the form answers that it cannot send.
# RESEND_API_KEY=
# CONTACT_FROM="Zámek Rosice <web@example.cz>"
# TURNSTILE_SECRET_KEY=

# Secrets for the Studio's preview. Locally they go in .dev.vars, in
# production they are Worker secrets (`wrangler secret put`). Never commit them.
# SANITY_API_READ_TOKEN=
# PREVIEW_SECRET=
