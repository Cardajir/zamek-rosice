---
import Button from "@/components/Button.astro";
import ContactLinesMain from "@/components/content/ContactLinesMain.astro";
import SanityImg from "@/components/media/SanityImg.astro";
import kudyznudy from "@/assets/partners/kudyznudy.webp";
import monogram from "@/assets/partners/monogram.svg";
import objevujPamatky from "@/assets/partners/objevuj-pamatky.webp";
import rosice from "@/assets/partners/rosice.svg";
import { DEFAULT_LANG, SITE_NAME } from "@/consts.ts";
import { ui } from "@/i18n/ui.ts";
import type { Shell } from "@/sanity/queries.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Contact details, link columns, partners and the closing call to action. */
  shell: Pick<
    Shell,
    | "organisation"
    | "phone"
    | "mobile"
    | "email"
    | "footerColumns"
    | "partners"
    | "cta"
  >;
  /** Set to `false` to leave out the call to action on the photograph. */
  cta?: boolean;
}

const { render = true, shell, cta: showCta = true } = Astro.props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const year = new Date().getFullYear();

/* "Správa zámku Rosice, příspěvková organizace": the name, then its legal form. */
const [name, ...form] = shell.organisation.split(", ");
const cta = showCta ? shell.cta : undefined;
/*
 * The marks the design sets in the footer, shown until the Studio names
 * partners for it. Sizes are the design's at 1920; a phone stacks them.
 */
const DESIGN_LOGOS = [
  { key: "monogram", name: "", url: "", image: monogram, width: 70, height: 67 },
  {
    key: "objevuj",
    name: "Objevuj památky",
    url: "",
    image: objevujPamatky,
    width: 138,
    height: 50,
  },
  {
    key: "kudyznudy",
    name: "Kudy z nudy",
    url: "https://www.kudyznudy.cz/",
    image: kudyznudy,
    width: 214,
    height: 58,
  },
  {
    key: "rosice",
    name: "Město Rosice",
    url: "https://www.rosice.cz/",
    image: rosice,
    width: 141,
    height: 36,
  },
];

/* One sentence to a line: "Máte dotaz?" above "Neváhejte se nám ozvat". */
const ctaLines = cta?.title?.split(/(?<=[?!.])\s+/) ?? [];
---

{render && (
  <footer class:list={["footer_wrap", cta && "has-cta"]}>
    {cta && (
      <div class:list={["footer_cta", "theme-dark", cta.image && "has-image"]}>
        {cta.image && <SanityImg image={{ ...cta.image, alt: "" }} />}
        <div class="footer_cta_content">
          <h2 class="footer_cta_title text-style-h1" data-reveal-letters>
            {ctaLines.map((line) => (
              <span>{line}</span>
            ))}
          </h2>
          {cta.link && (
            <Button element="link" variant="link" href={cta.link.href}>
              {cta.link.label}
            </Button>
          )}
        </div>
      </div>
    )}
    <div class="footer_inner">
      <div class="footer_top">
        <p class="footer_organisation">
          <strong>{`${name}${form.length > 0 ? "," : ""}`}</strong>
          {form.length > 0 && <span>{form.join(", ")}</span>}
        </p>
        <nav class="footer_nav" aria-label={t.footerNavigation}>
          {shell.footerColumns.map((column) => (
            <ul class="footer_links">
              {column.map((item) => (
                <li>
                  <a class="footer_link link-underline" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </nav>
      </div>
      <div class="footer_middle">
        <ContactLinesMain shell={shell} />
        {shell.partners.length === 0 && (
          <ul class="footer_partners is-design" role="list">
            {DESIGN_LOGOS.map((logo) => (
              <li class={`footer_logo is-${logo.key}`}>
                {logo.url ? (
                  <a
                    class="footer_partner"
                    href={logo.url}
                    aria-label={logo.name}
                    rel="noopener"
                  >
                    <img
                      src={logo.image.src}
                      width={logo.width}
                      height={logo.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={logo.image.src}
                    width={logo.width}
                    height={logo.height}
                    alt={logo.name}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </li>
            ))}
          </ul>
        )}
        {shell.partners.length > 0 && (
          <ul class="footer_partners" role="list">
            {shell.partners.map((partner) => (
              <li>
                {partner.url ? (
                  <a
                    class="footer_partner"
                    href={partner.url}
                    aria-label={partner.name}
                    rel="noopener"
                  >
                    {partner.logo ? (
                      <img src={partner.logo} alt="" loading="lazy" />
                    ) : (
                      partner.name
                    )}
                  </a>
                ) : partner.logo ? (
                  <img src={partner.logo} alt={partner.name} loading="lazy" />
                ) : (
                  partner.name
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
      <div class="footer_bottom">
        <p class="footer_copyright">
          <span>Copyright &copy; {year}, {SITE_NAME}.</span>{" "}
          <span>{t.allRightsReserved}</span>
        </p>
        <p>Design by Jakub Maca, 2026</p>
      </div>
    </div>
  </footer>
)}

<style is:global>
  @layer components {
    /*
     * The footer as the design draws it, at 1920 and on a 402px phone: a rule,
     * the call to action on a photograph, a rule, the organisation and links,
     * the contact lines and partner marks, a rule and the copyright, with a
     * generous margin left under it.
     */
    .footer_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-inline: var(--site-margin);
      /* 119px under the copyright at 1920, 64px on a phone. */
      padding-bottom: clamp(4rem, 3.0896rem + 3.6232vw, 7.4375rem);

      /*
       * The rule over the photograph: 14px above it at 1920, 9px on a phone.
       * Without the photograph the inner block's own rule is the only one.
       */
      &.has-cta::before {
        content: "";
        width: 100%;
        max-width: var(--max-width-main);
        margin-bottom: clamp(0.5625rem, 0.4797rem + 0.3294vw, 0.875rem);
        border-top: var(--border-width) solid var(--text);
      }
    }

    .footer_cta {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      display: grid;
      place-items: center;
      min-height: 22rem;
      padding: var(--section-space-medium) var(--space-6);
      background-color: var(--background);
      color: var(--text);
      overflow: clip;

      /* 1647 × 702 at 1920; 370 × 489 on a phone. */
      &.has-image {
        aspect-ratio: 370 / 489;
        min-height: 0;
        view-timeline: --footer-cta block;

        @media (width >= 48rem) {
          aspect-ratio: 1647 / 702;
          min-height: 26rem;
          max-height: 44rem;
        }
      }

      /*
       * The photograph moves slower than the page, by enough to see: it is
       * drawn a fifth larger and slides 8% up and down through that margin
       * as the block crosses the window. Still where that is unsupported or
       * unwanted.
       */
      & > .image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;

        @supports (animation-timeline: view()) {
          @media (prefers-reduced-motion: no-preference) {
            scale: 1.2;
            animation: footer-cta-drift linear both;
            animation-timeline: --footer-cta;
            animation-range: cover;
          }
        }
      }

      /* The design's 30% black over the photograph. */
      &.has-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background-color: color-mix(in lab, black 30%, transparent);
      }

      /*
       * The whole block is the link: the link's own area is stretched over
       * it, and the block clips it to its edges. Pointing anywhere on the
       * photograph plays the link's hover.
       */
      & .button_wrap::before {
        content: "";
        position: absolute;
        inset: -200vmax;
      }
    }

    @keyframes footer-cta-drift {
      from {
        translate: 0 -8%;
      }
      to {
        translate: 0 8%;
      }
    }

    .footer_cta_content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
      text-align: center;
    }

    /* The heading's own leading: 41.8 on 37 on a phone, 104 on 100 at 1920. */
    .footer_cta_title {
      max-width: 18.75rem;
      text-transform: uppercase;
      text-wrap: balance;
      & > span {
        display: block;
      }
      @media (width >= 48rem) {
        max-width: none;
      }
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      /* 13px under the photograph at 1920, 8px on a phone. */
      margin-top: clamp(0.5rem, 0.4172rem + 0.3294vw, 0.8125rem);
      /* 68px from the rule to the organisation at 1920, 17px on a phone. */
      padding-top: clamp(1.0625rem, 0.218rem + 3.36vw, 4.25rem);
      border-top: var(--border-width) solid var(--text);
    }

    .footer_top,
    .footer_middle {
      display: flex;
      flex-direction: column;
    }

    /* On a phone: the organisation small and to the right, as in the status bars above. */
    .footer_organisation {
      display: flex;
      flex-direction: column;
      align-self: end;
      margin: 0 0.125rem 0 0;
      font-size: 0.75rem;
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      text-align: end;
      & > strong {
        font-weight: inherit;
      }
      & > span::first-letter {
        text-transform: uppercase;
      }
    }

    /*
     * Three groups of links, 18px on a phone and 16px at 1920. On a phone
     * they start 16px in, on the line the text of the cards above keeps.
     */
    .footer_nav {
      display: grid;
      gap: 1.8125rem;
      margin-top: 3.4375rem;
      padding-left: 1rem;
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: 0.3125rem;
      font-size: clamp(1rem, 1.1583rem - 0.1318vw, 1.125rem);
      line-height: 1.4;
    }

    /*
     * On a phone the contact lines and the marks each sit between rules;
     * the lines are set like the opening heading, in capitals, and start on
     * the links' line.
     */
    .footer_middle {
      margin-top: 3.25rem;
      padding-top: 1.875rem;
      border-top: var(--border-width) solid var(--text);

      & > .contact-lines_wrap {
        @media (width < 64rem) {
          padding-left: 1rem;
          gap: 0.5rem;
          line-height: 1.2;
          letter-spacing: var(--letter-spacing-tight);
          text-transform: uppercase;
          font-feature-settings: "ordn", "ss05", "ss06", "ss07", "ss08", "ss09";
        }
      }
    }

    /*
     * No list marker at all: Safari lays the reset's empty marker on a line of
     * its own above a flex or grid item and pushes it down. role="list" keeps
     * the list for VoiceOver.
     */
    .footer_partners {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-6) var(--space-8);
      margin-top: 1.6875rem;
      padding-top: 2.5625rem;
      border-top: var(--border-width) solid var(--text);
      & img {
        max-height: 3rem;
        width: auto;
      }
    }

    .footer_partner {
      display: block;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    /*
     * The design's marks on a phone: three stacked on the left, the monogram
     * on the right standing on the same line as the last of them.
     */
    .footer_partners.is-design {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 0;

      & img {
        display: block;
        max-height: none;
        height: auto;
      }

      & > .is-kudyznudy {
        grid-area: 1 / 1;
        margin-left: 0.125rem;
        & img {
          width: 9.9375rem;
        }
      }
      & > .is-rosice {
        grid-area: 2 / 1;
        margin: 1.75rem 0 0 0.875rem;
        & img {
          width: 6.5625rem;
        }
      }
      & > .is-objevuj {
        grid-area: 3 / 1;
        margin: 2.125rem 0 0 0.875rem;
        & img {
          width: 6.4375rem;
        }
      }
      & > .is-monogram {
        grid-area: 1 / 2 / 4 / 3;
        align-self: end;
        margin-right: 1rem;
        & img {
          width: 5.5rem;
        }
      }
    }

    /* On a phone the copyright stands 2px in, as the organisation does on the right. */
    .footer_bottom {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 2.5625rem;
      padding-top: 1rem;
      padding-inline: 0.125rem;
      border-top: var(--border-width) solid var(--text);
      font-size: 0.75rem;
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      & > p {
        margin: 0;
      }
    }

    /* A phone breaks the copyright after the castle's name. */
    .footer_copyright > span {
      @media (width < 64rem) {
        display: block;
      }
    }

    @media (width >= 64rem) {
      .footer_top,
      .footer_middle {
        flex-direction: row;
        justify-content: space-between;
        align-items: start;
      }

      .footer_organisation {
        align-self: start;
        margin-right: 0;
        font-size: var(--text-small);
        font-weight: var(--primary-regular);
        line-height: 1.4;
        letter-spacing: var(--letter-spacing-wide);
        text-align: start;
        & > strong {
          font-weight: var(--primary-semibold);
        }
      }

      /* The links start 24px lower than the organisation, 51% across, in columns 267px apart. */
      .footer_nav {
        grid-template-columns: 33.25% 33.5% auto;
        flex: 0 0 48.8%;
        gap: var(--space-6) 0;
        margin-top: 1.25rem;
        padding-left: 0;
      }

      .footer_middle {
        align-items: end;
        margin-top: 5.8125rem;
        padding-top: 0;
        border-top: 0;
      }

      .footer_partners {
        flex: 0 0 48.8%;
        justify-content: space-between;
        flex-wrap: nowrap;
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }

      /* At 1920 the four marks share the links' width in one row, the last 27px short of the edge. */
      .footer_partners.is-design {
        display: flex;
        align-items: center;
        padding-right: 1.6875rem;
        padding-bottom: 0.25rem;

        & > .is-kudyznudy,
        & > .is-rosice,
        & > .is-objevuj {
          margin: 0;
        }
        & > .is-monogram {
          margin-right: 0;
          & img {
            width: 4.375rem;
          }
        }
        & > .is-objevuj img {
          width: 8.625rem;
        }
        & > .is-kudyznudy img {
          width: 13.375rem;
        }
        & > .is-rosice img {
          width: 8.8125rem;
        }
      }

      .footer_bottom {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-2) var(--space-6);
        margin-top: 2.8125rem;
        padding-top: 1.3125rem;
        padding-inline: 0;
        font-size: var(--text-small);
        line-height: 1.4;
        letter-spacing: var(--letter-spacing-wide);
      }
    }
  }
</style>
