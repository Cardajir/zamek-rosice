---
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import facebook from "@/assets/icons/facebook.svg";
import instagram from "@/assets/icons/instagram.svg";
import { DEFAULT_LANG, LANG_NAMES, SITE_NAME, type Lang } from "@/consts.ts";
import { routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import type { Shell } from "@/sanity/queries.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Menu groups, top links and social profiles. */
  shell: Pick<Shell, "groups" | "topLinks" | "socials">;
  /** This page in each language it exists in, for the language switcher. */
  languages?: { lang: Lang; path: string }[];
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, shell, languages = [], overlap = false } = Astro.props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const current = (Astro.locals.pathname ?? Astro.url.pathname).replace(
  /\/+$/,
  "",
);
const isCurrent = (href: string) => href.replace(/\/+$/, "") === current;

const SOCIAL_ICONS = { facebook, instagram } as const;
const socials = shell.socials.flatMap(({ network, url }) =>
  network in SOCIAL_ICONS
    ? [
        {
          url,
          name: network.charAt(0).toUpperCase() + network.slice(1),
          icon: SOCIAL_ICONS[network as keyof typeof SOCIAL_ICONS],
        },
      ]
    : [],
);
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href={routePath("home", lang)} aria-label={SITE_NAME}>
        <span>zámek</span>
        <span>Rosice</span>
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label={t.mainNavigation}>
        <div class="nav_menu_inner">
          <ul class="nav_groups">
            {shell.groups.map((group, index) => (
              <li class="nav_group">
                <button
                  class="nav_group_button"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-panel-${index}`}
                >
                  <span>{group.label}</span>
                  <Icon class="nav_group_arrow" src={arrow} variant="small" />
                </button>
                <div class="nav_panel" id={`nav-panel-${index}`}>
                  <ul class="nav_panel_list">
                    {group.items.map((item) => (
                      <li>
                        <a
                          class="nav_panel_link"
                          href={item.href}
                          aria-current={
                            isCurrent(item.href) ? "page" : undefined
                          }
                        >
                          <Icon
                            class="nav_panel_arrow"
                            src={arrow}
                            variant="small"
                          />
                          <span>{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
          <div class="nav_aside">
            <ul class="nav_top">
              {shell.topLinks.map((item) => (
                <li>
                  <a
                    class="nav_top_link"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
            {languages.length > 1 && (
              <ul class="nav_langs" aria-label={t.languageSwitcher}>
                {languages.map((item) => (
                  <li>
                    <a
                      class="nav_lang"
                      href={item.path}
                      hreflang={item.lang}
                      lang={item.lang}
                      aria-label={LANG_NAMES[item.lang]}
                      aria-current={item.lang === lang ? "true" : undefined}
                    >
                      {item.lang.toUpperCase()}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {socials.length > 0 && (
              <ul class="nav_socials">
                {socials.map((social) => (
                  <li>
                    <a
                      class="nav_social"
                      href={social.url}
                      aria-label={social.name}
                      rel="noopener"
                    >
                      <Icon src={social.icon} variant="small" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      position: static;
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
    .nav_panel {
      position: static;
      grid-template-rows: 1fr;
      visibility: visible;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const groups = [
      ...nav.querySelectorAll<HTMLButtonElement>(".nav_group_button"),
    ];
    const desktop = window.matchMedia("(width >= 80rem)");

    const setGroup = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.closest(".nav_group")?.classList.toggle("open", open);
    };

    const closeGroups = (except?: HTMLButtonElement) => {
      groups.forEach((button) => {
        if (button !== except) setGroup(button, false);
      });
    };

    const setMenu = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
      );
      if (!open) closeGroups();
    };

    toggle.addEventListener("click", () => {
      setMenu(toggle.getAttribute("aria-expanded") !== "true");
    });

    groups.forEach((button) => {
      button.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") !== "true";
        closeGroups(button);
        setGroup(button, open);
      });
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openGroup = groups.find(
        (button) => button.getAttribute("aria-expanded") === "true",
      );
      if (openGroup) {
        setGroup(openGroup, false);
        openGroup.focus();
      } else if (nav.classList.contains("open")) {
        setMenu(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node) || nav.contains(target)) return;
      closeGroups();
      if (nav.classList.contains("open")) setMenu(false);
    });

    nav.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (!desktop.matches || !(next instanceof Node)) return;
      const group = (event.target as HTMLElement).closest(".nav_group");
      if (group && !group.contains(next)) closeGroups();
    });

    desktop.addEventListener("change", () => setMenu(false));
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0 var(--space-6);
      min-height: var(--nav-height);
      border-bottom: var(--border-width) solid var(--text);
    }

    .nav_logo {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: var(--secondary-family);
      font-weight: var(--secondary-medium);
      font-size: var(--h4);
      line-height: 0.8;
      letter-spacing: var(--letter-spacing-tight);
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      & > span:first-child {
        padding-left: 1em;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.75rem;
      --_bar-gap: 0.5rem;
      grid-column: 3;
      justify-self: end;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(20deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-20deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: calc(var(--site-margin) * -1);
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      padding-inline: var(--site-margin);
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
      min-height: calc(100svh - var(--nav-height));
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
    }

    .nav_group,
    .nav_top > li {
      border-bottom: var(--border-width) solid var(--text);
    }

    .nav_group_button,
    .nav_top_link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      width: 100%;
      padding-block: var(--space-5);
      color: inherit;
      font-family: var(--secondary-family);
      font-weight: var(--secondary-medium);
      font-size: var(--h2);
      line-height: var(--line-height-medium);
      letter-spacing: var(--letter-spacing-snug);
      text-align: start;
      text-decoration: none;
    }

    .nav_group_arrow {
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
      .nav_group.open & {
        rotate: -90deg;
      }
    }

    .nav_group.open .nav_group_button {
      color: var(--muted-500);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: var(--border-width);
    }

    .nav_panel {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
      .nav_group.open & {
        grid-template-rows: 1fr;
        visibility: visible;
      }
    }

    .nav_panel_list {
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      .nav_group.open & {
        padding-bottom: var(--space-5);
      }
    }

    .nav_panel_link {
      display: block;
      font-size: var(--text-main);
      text-decoration: none;
      text-underline-offset: 0.2em;
      text-decoration-thickness: var(--border-width);
      &[aria-current="page"] {
        text-decoration: underline;
      }
    }

    .nav_panel_arrow {
      display: none;
    }

    .nav_aside {
      display: flex;
      flex-direction: column;
    }

    .nav_langs,
    .nav_socials {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      padding-block: var(--space-5);
    }

    .nav_lang {
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      color: var(--muted-text);
      text-decoration: none;
      &[aria-current="true"] {
        color: var(--text);
      }
    }

    .nav_social {
      display: flex;
      align-items: center;
      min-width: 1.5rem;
      min-height: 1.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    @media (width >= 80rem) {
      .nav_toggle {
        display: none;
      }

      .nav_logo {
        grid-row: 1;
      }

      .nav_menu,
      .nav_menu_inner {
        display: contents;
        visibility: visible;
        opacity: 1;
      }

      .nav_groups {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        align-items: center;
        gap: var(--space-6);
      }

      .nav_group,
      .nav_top > li {
        border-bottom: 0;
      }

      .nav_group_button,
      .nav_top_link {
        width: auto;
        padding-block: var(--space-2);
        gap: var(--space-2);
        font-family: var(--primary-family);
        font-weight: var(--primary-medium);
        font-size: var(--text-small);
        letter-spacing: var(--letter-spacing-normal);
        white-space: nowrap;
        transition: color var(--hover-duration) var(--hover-ease);
      }

      .nav_groups:has(.nav_group.open) .nav_group:not(.open) .nav_group_button {
        color: var(--muted-text);
      }

      .nav_group.open .nav_group_button {
        color: inherit;
        text-decoration: none;
      }

      .nav_top_link {
        text-underline-offset: 0.4em;
        text-decoration-thickness: var(--border-width);
        &[aria-current="page"] {
          text-decoration: underline;
        }
        @media (hover: hover) {
          &:hover {
            color: var(--muted-text);
          }
        }
      }

      .nav_panel {
        position: absolute;
        top: calc(100% + var(--border-width));
        inset-inline: 0;
        background-color: var(--background);
      }

      .nav_panel_list {
        gap: 0;
        .nav_group.open & {
          padding-bottom: 0;
        }
        & > li {
          border-bottom: var(--border-width) solid var(--text);
        }
      }

      .nav_panel_link {
        display: flex;
        align-items: center;
        gap: var(--space-7);
        padding: var(--space-6) var(--space-2);
        font-family: var(--secondary-family);
        font-weight: var(--secondary-medium);
        font-size: var(--h3);
        line-height: var(--line-height-medium);
        letter-spacing: var(--letter-spacing-snug);
        transition: padding-left var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            padding-left: var(--space-5);
            & > span {
              text-decoration: underline;
              text-underline-offset: 0.15em;
              text-decoration-thickness: var(--border-width);
            }
          }
        }
        &:focus-visible > span {
          text-decoration: underline;
        }
      }

      .nav_panel_arrow {
        display: block;
        --_size: 0.6em;
      }

      .nav_aside {
        grid-column: 3;
        grid-row: 1;
        flex-direction: row;
        align-items: center;
        justify-content: end;
        gap: var(--space-6);
      }

      .nav_top {
        display: flex;
        align-items: center;
        gap: var(--space-6);
      }

      .nav_langs,
      .nav_socials {
        padding-block: 0;
        gap: var(--space-3);
      }
    }
  }
</style>
