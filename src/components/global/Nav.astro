---
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import arrowDown from "@/assets/icons/arrow-down.svg";
import facebook from "@/assets/icons/facebook.svg";
import instagram from "@/assets/icons/instagram.svg";
import Logo from "@/assets/logo/zamek-rosice.svg";
import { DEFAULT_LANG, LANG_NAMES, SITE_NAME, type Lang } from "@/consts.ts";
import { routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import type { Shell } from "@/sanity/queries.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Menu groups, top links and social profiles. */
  shell: Pick<Shell, "groups" | "mainLinks" | "topLinks" | "socials">;
  /** This page in each language it exists in, for the language switcher. */
  languages?: { lang: Lang; path: string }[];
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, shell, languages = [], overlap = false } = Astro.props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const current = (Astro.locals.pathname ?? Astro.url.pathname).replace(
  /\/+$/,
  "",
);
const isCurrent = (href: string) => href.replace(/\/+$/, "") === current;
/* A group holds the page when one of its pages is it or contains it (a detail page). */
const holdsCurrent = (items: { href: string }[]) =>
  items.some(({ href }) => {
    const path = href.replace(/\/+$/, "");
    return path !== "" && (path === current || current.startsWith(`${path}/`));
  });

const SOCIAL_ICONS = { facebook, instagram } as const;
const socials = shell.socials.flatMap(({ network, url }) =>
  network in SOCIAL_ICONS
    ? [
        {
          url,
          name: network.charAt(0).toUpperCase() + network.slice(1),
          icon: SOCIAL_ICONS[network as keyof typeof SOCIAL_ICONS],
        },
      ]
    : [],
);
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      {socials.length > 0 && (
        <ul class="nav_bar_socials" role="list">
          {socials.map((social) => (
            <li>
              <a
                class="nav_social"
                href={social.url}
                aria-label={social.name}
                rel="noopener"
              >
                <Icon src={social.icon} variant="small" />
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="nav_logo" href={routePath("home", lang)} aria-label={SITE_NAME}>
        <Logo class="nav_logo_mark" />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label={t.mainNavigation}>
        <div class="nav_menu_inner">
          <ul class="nav_groups">
            {shell.groups.map((group, index) => (
              <li class="nav_group">
                <button
                  class="nav_group_button"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-panel-${index}`}
                >
                  <span
                    class:list={[
                      "link-underline",
                      holdsCurrent(group.items) && "is-current",
                    ]}
                  >
                    {group.label}
                  </span>
                  <Icon
                    class="nav_group_arrow"
                    src={arrowDown}
                    variant="small"
                  />
                </button>
                <div class="nav_panel" id={`nav-panel-${index}`}>
                  <ul class="nav_panel_list" role="list">
                    {group.items.map((item, itemIndex) => (
                      <li style={`--_i: ${itemIndex}`}>
                        <a
                          class="nav_panel_link"
                          href={item.href}
                          aria-current={
                            isCurrent(item.href) ? "page" : undefined
                          }
                        >
                          <Icon
                            class="nav_panel_arrow"
                            src={arrow}
                            variant="small"
                          />
                          <span class="link-underline">{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
            {shell.mainLinks.map((item) => (
              <li class="nav_group nav_main">
                <a
                  class="nav_top_link"
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  <span
                    class:list={[
                      "link-underline",
                      holdsCurrent([item]) && "is-current",
                    ]}
                  >
                    {item.label}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="nav_aside">
            <ul class="nav_top">
              {shell.topLinks.map((item) => (
                <li>
                  <a
                    class="nav_top_link"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    <span class="link-underline">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
            {languages.length > 1 && (
              <div class="nav_group nav_lang">
                <button
                  class="nav_group_button"
                  type="button"
                  aria-label={`${t.languageSwitcher}: ${LANG_NAMES[lang]}`}
                  aria-expanded="false"
                  aria-controls="nav-panel-lang"
                >
                  <span class="nav_lang_code link-underline" aria-hidden="true">
                    {lang.toUpperCase()}
                  </span>
                  <span class="nav_lang_name link-underline" aria-hidden="true">
                    {LANG_NAMES[lang]}
                  </span>
                  <Icon
                    class="nav_group_arrow"
                    src={arrowDown}
                    variant="small"
                  />
                </button>
                <div class="nav_panel" id="nav-panel-lang">
                  <ul class="nav_panel_list" role="list">
                    {languages.map((item) => (
                      <li>
                        <a
                          class="nav_panel_link"
                          href={item.path}
                          hreflang={item.lang}
                          lang={item.lang}
                          aria-current={item.lang === lang ? "true" : undefined}
                        >
                          <Icon
                            class="nav_panel_arrow"
                            src={arrow}
                            variant="small"
                          />
                          <span class="link-underline">{LANG_NAMES[item.lang]}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
            {socials.length > 0 && (
              <ul class="nav_socials" role="list">
                {socials.map((social) => (
                  <li>
                    <a
                      class="nav_social"
                      href={social.url}
                      aria-label={social.name}
                      rel="noopener"
                    >
                      <Icon src={social.icon} variant="small" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      position: static;
      height: auto;
      visibility: visible;
      opacity: 1;
      translate: none;
    }
    .nav_panel {
      position: static;
      grid-template-rows: 1fr;
      visibility: visible;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const groups = [
      ...nav.querySelectorAll<HTMLButtonElement>(".nav_group_button"),
    ];
    const desktop = window.matchMedia("(width >= 85rem)");

    const setGroup = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.closest(".nav_group")?.classList.toggle("open", open);
    };

    const closeGroups = (except?: HTMLButtonElement) => {
      groups.forEach((button) => {
        if (button !== except) setGroup(button, false);
      });
    };

    const behind = document.querySelectorAll<HTMLElement>("main, footer");

    const setMenu = (open: boolean) => {
      nav.classList.toggle("open", open);
      behind.forEach((element) => element.toggleAttribute("inert", open));
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
      );
      if (!open) closeGroups();
    };

    toggle.addEventListener("click", () => {
      setMenu(toggle.getAttribute("aria-expanded") !== "true");
    });

    /*
     * On the desktop bar a mouse opens a group by pointing at it. Pointing at
     * the logo or a plain link closes it again, and so does leaving the bar
     * and its panel. A click right after the panel opened that way leaves it
     * open instead of shutting what the pointer just opened.
     */
    const mouse = (event: PointerEvent) =>
      event.pointerType === "mouse" && desktop.matches;
    let hoveredAt = 0;
    let leaving: number | undefined;

    groups.forEach((button) => {
      button.addEventListener("pointerenter", (event) => {
        if (!mouse(event)) return;
        window.clearTimeout(leaving);
        if (button.getAttribute("aria-expanded") === "true") return;
        closeGroups(button);
        setGroup(button, true);
        hoveredAt = performance.now();
      });
    });

    nav
      .querySelectorAll<HTMLElement>(".nav_logo, .nav_top_link, .nav_social")
      .forEach((element) => {
        element.addEventListener("pointerenter", (event) => {
          if (mouse(event)) closeGroups();
        });
      });

    nav.addEventListener("pointerenter", () => window.clearTimeout(leaving));
    nav.addEventListener("pointerleave", (event) => {
      if (!mouse(event)) return;
      leaving = window.setTimeout(() => closeGroups(), 250);
    });

    groups.forEach((button) => {
      button.addEventListener("click", () => {
        if (
          desktop.matches &&
          button.getAttribute("aria-expanded") === "true" &&
          performance.now() - hoveredAt < 700
        ) {
          return;
        }
        const open = button.getAttribute("aria-expanded") !== "true";
        closeGroups(button);
        setGroup(button, open);
        /* In the full-height menu the group that just opened may reach below the screen. */
        if (open && !desktop.matches) {
          window.setTimeout(() => {
            button
              .closest(".nav_group")
              ?.scrollIntoView({ block: "nearest", behavior: "smooth" });
          }, 220);
        }
      });
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openGroup = groups.find(
        (button) => button.getAttribute("aria-expanded") === "true",
      );
      if (openGroup) {
        setGroup(openGroup, false);
        openGroup.focus();
      } else if (nav.classList.contains("open")) {
        setMenu(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node) || nav.contains(target)) return;
      closeGroups();
      if (nav.classList.contains("open")) setMenu(false);
    });

    nav.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (!desktop.matches || !(next instanceof Node)) return;
      const group = (event.target as HTMLElement).closest(".nav_group");
      if (group && !group.contains(next)) closeGroups();
    });

    desktop.addEventListener("change", () => setMenu(false));
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0 clamp(1rem, 2vw, 2.5rem);
      min-height: var(--nav-height);
      border-bottom: var(--border-width) solid var(--text);
    }

    .nav_logo {
      grid-column: 2;
      display: flex;
      transition: opacity var(--hover-duration) var(--hover-ease);
      & > .nav_logo_mark {
        flex: none;
        width: clamp(6.75rem, 8.49vw, 10.1875rem);
        max-width: none;
        height: auto;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    /* Two 31px bars 9px apart, crossing into a 27 × 16 cross when open. */
    .nav_toggle {
      --_icon-width: 1.9375rem;
      --_bar-gap: 0.5625rem;
      grid-column: 3;
      justify-self: end;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      /* The bars stop 10px short of the rule, as the design draws them. */
      margin-right: calc((2.75rem - var(--_icon-width)) / -2 + 0.625rem);
      color: inherit;
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(29deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-29deg);
      }
    }

    /*
     * Below the desktop width the menu is a panel as tall as the screen under
     * the bar. It scrolls on its own; the page behind it does not.
     */
    html:has(.nav_wrap.open) {
      overflow: hidden;
    }

    .nav_menu {
      /* 24px above and below each 26px row, as the phone design spaces them. */
      --_row-pad: clamp(0.875rem, 2.75svh, 1.5rem);
      --_row-size: clamp(1.375rem, 3svh, 1.625rem);
      /* Under the bar's rule, so the rule stays above the first row. */
      position: absolute;
      top: calc(100% + var(--border-width));
      inset-inline: calc(var(--site-margin) * -1);
      height: calc(100dvh - var(--nav-height));
      visibility: hidden;
      opacity: 0;
      translate: 0 -0.5rem;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      transition:
        opacity var(--open-duration) var(--open-ease),
        translate var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding-inline: var(--site-margin);
      padding-bottom: max(var(--space-4), env(safe-area-inset-bottom));
    }

    .nav_wrap.open .nav_menu {
      visibility: visible;
      opacity: 1;
      translate: none;
    }

    .nav_group,
    .nav_top > li {
      border-bottom: var(--border-width) solid var(--text);
    }

    .nav_group_button,
    .nav_top_link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      width: 100%;
      padding-block: var(--_row-pad);
      color: inherit;
      font-family: var(--secondary-family);
      font-weight: var(--secondary-medium);
      font-size: var(--_row-size);
      line-height: 1.05;
      letter-spacing: var(--letter-spacing-snug);
      text-align: start;
      text-decoration: none;
    }

    /* The drawn arrow, 16 × 19. */
    .nav_group_button > .nav_group_arrow.icon {
      --_size: 1rem;
      aspect-ratio: 16 / 19;
      transition: rotate var(--open-duration) var(--open-ease);
      .nav_group.open & {
        rotate: 180deg;
      }
    }

    /*
     * Labels laid out as flex items end at their tight line box, so their
     * underline would touch the letters: a little room under them, taken
     * back from the layout, sets the line as far below the words as elsewhere.
     */
    :is(.nav_group_button, .nav_top_link) > .link-underline {
      padding-bottom: 0.12em;
      margin-bottom: -0.12em;
    }
    @media (width >= 85rem) {
      .nav_panel_link > .link-underline {
        padding-bottom: 0.12em;
        margin-bottom: -0.12em;
      }
    }

    /* The group holding the page you are on keeps its name underlined. */
    :is(.nav_group_button, .nav_top_link) > .link-underline.is-current {
      background-position-x: 0%;
      background-size: 100% var(--link-underline-width);
    }

    /* On a phone an open group's name greys and keeps its line drawn, as the design shows. */
    .nav_group.open .nav_group_button {
      color: var(--muted-500);
      @media (width < 85rem) {
        & .link-underline {
          background-position-x: 0%;
          background-size: 100% var(--link-underline-width);
        }
      }
    }

    .nav_panel {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
      .nav_group.open & {
        grid-template-rows: 1fr;
        visibility: visible;
      }
    }

    /*
     * The pages of an open group: 18px, 33px apart, under its name with a
     * little more room than the design's 24px, as asked.
     */
    .nav_panel_list {
      overflow: hidden;
      display: flex;
      flex-direction: column;
      .nav_group.open & {
        margin-top: -0.25rem;
        padding-bottom: 0.875rem;
      }
    }

    .nav_panel_link {
      display: block;
      padding-block: 0.25rem;
      font-size: 1.125rem;
      line-height: 1.4;
      text-decoration: none;
    }

    .nav_panel_arrow {
      display: none;
    }

    .nav_aside {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /*
     * Below the desktop width the social links sit on the bar, left of the
     * logo, the two marks 16px apart as the design spaces them.
     */
    .nav_bar_socials {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-left: 0.1875rem;
      font-size: 1.1875rem;
    }

    /*
     * No list marker at all: Safari lays the reset's empty marker on a line of
     * its own above a flex or grid item and pushes it down. role="list" keeps
     * the list for VoiceOver.
     */
    :is(.nav_bar_socials, .nav_socials, .nav_panel_list) {
      list-style: none;
    }

    .nav_socials {
      display: none;
      align-items: center;
      gap: var(--space-5);
      margin-top: auto;
      padding-block: var(--_row-pad);
    }

    /*
     * Each mark is 19px tall and as wide as it is drawn, so the Facebook "f"
     * starts where the design puts it. The height is set outright: Safari
     * otherwise sizes an inline SVG from its own 10 × 18 proportions, which
     * made the "f" taller than the bar's middle on an iPhone. A larger
     * invisible area keeps each easy to tap.
     */
    .nav_social {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 1.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &::before {
        content: "";
        position: absolute;
        inset: -0.625rem -0.4375rem;
      }
      & > .icon {
        width: auto;
        height: var(--_size);
        aspect-ratio: auto;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    /* On the bar the language is its code; in the opened menu, its name. */
    .nav_lang_code {
      display: none;
    }

    @media (width >= 85rem) {
      html:has(.nav_wrap.open) {
        overflow: visible;
      }

      .nav_toggle,
      .nav_bar_socials {
        display: none;
      }

      .nav_logo {
        grid-row: 1;
      }

      .nav_menu,
      .nav_menu_inner {
        display: contents;
        visibility: visible;
        opacity: 1;
        translate: none;
      }

      .nav_groups {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        align-items: center;
        gap: clamp(1rem, 2vw, 2.375rem);
      }

      .nav_group,
      .nav_top > li {
        border-bottom: 0;
      }

      .nav_lang_code {
        display: inline;
      }

      .nav_lang_name {
        display: none;
      }

      .nav_group_button > .nav_group_arrow.icon {
        --_size: 1.0556em;
        aspect-ratio: 1 / 1;
      }

      .nav_group_button,
      .nav_top_link {
        width: auto;
        padding-block: var(--space-2);
        line-height: var(--line-height-medium);
        gap: 0.66em;
        font-family: var(--primary-family);
        font-weight: var(--primary-semibold);
        font-size: var(--text-main);
        letter-spacing: var(--letter-spacing-snug);
        white-space: nowrap;
        transition: color var(--hover-duration) var(--hover-ease);
      }

      /* The bar keeps one colour; hover and the open group show by their underline only. */
      .nav_group.open .nav_group_button {
        color: inherit;
      }

      .nav_panel {
        position: absolute;
        top: calc(100% + var(--border-width));
        inset-inline: 0;
        background-color: var(--background);
      }

      .nav_panel_list {
        gap: 0;
        .nav_group.open & {
          margin-top: 0;
          padding-bottom: 0;
        }
        & > li {
          border-bottom: var(--border-width) solid var(--text);
        }
      }

      /*
       * As the panel slides down, its pages arrive one after another, each
       * rising into place a moment after the one above it.
       */
      @media (prefers-reduced-motion: no-preference) {
        .nav_group.open .nav_panel_list > li {
          animation: nav-panel-item 0.35s var(--open-ease) both;
          animation-delay: calc(0.08s + var(--_i, 0) * 0.05s);
        }
      }

      @keyframes nav-panel-item {
        from {
          opacity: 0;
          translate: 0 0.5rem;
        }
        to {
          opacity: 1;
          translate: none;
        }
      }

      /*
       * A page of the open group as the design draws it at 1920: 48px words
       * starting 120px in, a 38 × 31 arrow 11px in, rows 135px apart. On
       * hover only the arrow steps 22px towards the words; the shared link
       * underline draws under them.
       */
      .nav_panel_link {
        display: flex;
        align-items: center;
        gap: 1.4583em;
        padding: var(--space-6) var(--space-2) var(--space-6) 0.2292em;
        font-family: var(--secondary-family);
        font-weight: var(--secondary-medium);
        font-size: clamp(2.25rem, 0.4286rem + 2.1429vw, 3rem);
        line-height: var(--line-height-medium);
        letter-spacing: var(--letter-spacing-snug);
        @media (hover: hover) {
          &:hover {
            & > .nav_panel_arrow {
              translate: 0.4583em 0;
            }
          }
        }
      }

      .nav_panel_link > .nav_panel_arrow.icon {
        display: block;
        --_size: 0.7917em;
        transition: translate var(--hover-duration) var(--hover-ease);
