---
import SanityImg from "@/components/media/SanityImg.astro";

interface Props {
  /** The image block as the query returns it. */
  node: {
    url?: string;
    width?: number;
    height?: number;
    alt?: string;
    caption?: string;
    credit?: string;
    hotspot?: { x?: number; y?: number } | null;
  };
  /**
   * Width divided by height to crop the photograph to. Omit to keep its own shape.
   *
   * @min 0
   */
  ratio?: number;
  /** Responsive `sizes` value. */
  sizes?: string;
}

const { node, ratio, sizes = "(width >= 82rem) 82rem, 100vw" } = Astro.props;
const url = node.url;
const note = [node.caption, node.credit].filter(Boolean).join(" · ");
---

{url && (
  <figure class="portable-image_wrap">
    <SanityImg
      image={{ ...node, url, focus: node.hotspot }}
      ratio={ratio}
      sizes={sizes}
      maxWidth={1600}
    />
    {note && <figcaption class="portable-image_caption">{note}</figcaption>}
  </figure>
)}

<style is:global>
  @layer components {
    .portable-image_wrap {
      width: 100%;
      margin: 0;

      & > .image {
        display: block;
        width: 100%;
        height: auto;
        background-color: var(--background-2);
      }
    }

    /* The design's caption: set right under the photograph, semibold. */
    .portable-image_caption {
      max-width: 22em;
      margin: clamp(1rem, 0.8047rem + 0.7773vw, 1.7375rem) 0 0 auto;
      font-size: clamp(0.75rem, 0.6507rem + 0.3953vw, 1.125rem);
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      text-align: end;
      text-wrap: balance;
      text-box: trim-both cap alphabetic;
    }
  }
</style>
