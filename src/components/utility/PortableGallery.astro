---
import type { ComponentProps } from "astro/types";
import PortableImage from "@/components/utility/PortableImage.astro";
import { photoPlaces } from "@/utils/text-blocks.ts";

type Photo = ComponentProps<typeof PortableImage>["node"];

interface Props {
  /** Consecutive photographs from the text, gathered by `photoRuns`. */
  node: { images?: Photo[] };
}

const { node } = Astro.props;
const photos = (node.images ?? []).filter((photo) => photo.url);
const places = photoPlaces(photos.length);

/* The tour pages' crops; a wide landscape photograph keeps its own shape. */
const SIZES = {
  wide: { ratio: 1312 / 877, sizes: "(width >= 82rem) 82rem, 100vw" },
  half: { ratio: 640 / 451, sizes: "(width >= 48rem) 40vw, 100vw" },
  quarter: { ratio: 312 / 228, sizes: "(width >= 48rem) 20vw, 50vw" },
} as const;

const note = (photo?: Photo) =>
  photo ? [photo.caption, photo.credit].filter(Boolean).join(" · ") : "";
const landscape = (photo: Photo) =>
  Boolean(photo.width && photo.height && photo.width >= photo.height);
---

{photos.length > 0 && (
  <div class="portable-gallery_wrap">
    {photos.map((photo, index) => {
      const place = places[index]!;
      const size = SIZES[place.size];
      /* A caption repeated under a series is set once, under its last photograph. */
      const shown =
        note(photo) && note(photo) === note(photos[index + 1])
          ? { ...photo, caption: undefined, credit: undefined }
          : photo;
      return (
        <div
          class="portable-gallery_item"
          data-size={place.size}
          data-column={place.column}
        >
          <PortableImage
            node={shown}
            ratio={
              place.size === "wide" && landscape(photo) ? undefined : size.ratio
            }
            sizes={size.sizes}
          />
        </div>
      );
    })}
  </div>
)}

<style is:global>
  @layer components {
    /*
     * Photographs in text, laid out as the tour pages lay theirs: seven
     * tracks at 1920 (312 16 312 33 312 16 312), a wide photograph across
     * them all, a half over three, a quarter in one. On a phone the wide ones
     * and halves fill the column and the quarters go two to a row.
     */
    .portable-gallery_wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr);
      row-gap: clamp(1.875rem, 1.534rem + 1.357vw, 3.1625rem);
      align-items: start;
      @media (width >= 48rem) {
        grid-template-columns:
          minmax(0, 1fr) 1rem minmax(0, 1fr) clamp(1rem, 1.719vw, 2.0625rem)
          minmax(0, 1fr) 1rem minmax(0, 1fr);
      }
    }

    .portable-gallery_item {
      grid-column: 1 / -1;
      min-width: 0;

      @media (width < 48rem) {
        &[data-size="quarter"]:is([data-column="0"], [data-column="2"]) {
          grid-column: 1;
        }
        &[data-size="quarter"]:is([data-column="1"], [data-column="3"]) {
          grid-column: 3;
        }
      }

      @media (width >= 48rem) {
        &[data-size="half"][data-column="0"] {
          grid-column: 1 / 4;
        }
        &[data-size="half"][data-column="1"] {
          grid-column: 5 / 8;
        }
        &[data-size="quarter"][data-column="0"] {
          grid-column: 1;
        }
        &[data-size="quarter"][data-column="1"] {
          grid-column: 3;
        }
        &[data-size="quarter"][data-column="2"] {
          grid-column: 5;
        }
        &[data-size="quarter"][data-column="3"] {
          grid-column: 7;
        }
      }
    }
  }
</style>
