---
/*
 * Content below the first screen fades up into place as it is scrolled to;
 * things that arrive together follow one another. A big heading marked
 * `data-reveal-letters` is written out letter by letter instead, each letter
 * coming up out of the white a moment after the one before it. Nothing is
 * hidden without JavaScript, for a visitor who asked for less motion, or on
 * paper.
 */
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{render && <span class="reveal_wrap" hidden data-reveal-root />}

<script>
  const root = document.querySelector("[data-reveal-root]");
  const main = document.querySelector("main");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  const lettered = [
    ...document.querySelectorAll<HTMLElement>("[data-reveal-letters]"),
  ];
  const able =
    Boolean(root && main) && !calm.matches && "IntersectionObserver" in window;

  /* Things come in once they are this far up into the window. */
  const ROOT_MARGIN = "0px 0px -18% 0px";

  if (able && main) {
    /* Wrappers whose items come in one by one instead of as a block. */
    const GROUPS = [
      ".layout",
      ".layout > div",
      ".grid",
      ".events_wrap",
      ".tours_wrap",
      ".gallery_list",
      ".gallery-nav_list",
      ".info-list_wrap",
      ".promo_wrap",
    ].join(", ");
    const STEP = 96;
    const MOST = 6;

    const targets: HTMLElement[] = [];
    const collect = (element: Element) => {
      if (element.matches(GROUPS)) {
        for (const child of element.children) collect(child);
      } else if (
        element instanceof HTMLElement &&
        !element.hidden &&
        /* A lettered heading brings itself in. */
        !element.matches("[data-reveal-letters]")
      ) {
        targets.push(element);
      }
    };
    for (const container of main.querySelectorAll(".section > .container")) {
      for (const child of container.children) collect(child);
    }

    const settle = (element: HTMLElement) => {
      element.removeAttribute("data-reveal");
      element.style.removeProperty("transition-delay");
    };

    const show = (element: HTMLElement, delay: number) => {
      if (element.dataset.reveal !== "out") return;
      element.style.transitionDelay = `${delay}ms`;
      element.dataset.reveal = "in";
      /* Once in place the element is left exactly as its own styles have it. */
      window.setTimeout(() => settle(element), delay + 1200);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              a.boundingClientRect.top - b.boundingClientRect.top ||
              a.boundingClientRect.left - b.boundingClientRect.left,
          )
          .forEach((entry, index) => {
            observer.unobserve(entry.target);
            show(entry.target as HTMLElement, Math.min(index, MOST) * STEP);
          });
      },
      { rootMargin: ROOT_MARGIN, threshold: 0.01 },
    );

    /* What is already on screen stays put: no flash, and the page's first paint is not held back. */
    const fold = window.innerHeight;
    /* All positions are read before any is hidden, so the page is laid out once rather than once per element. */
    const below = targets.filter(
      (target) => target.getBoundingClientRect().top >= fold,
    );
    for (const target of below) {
      target.dataset.reveal = "out";
      observer.observe(target);
    }

    /* Keyboard focus never lands on something still invisible. */
    main.addEventListener("focusin", (event) => {
      const hidden = (event.target as Element).closest<HTMLElement>(
        '[data-reveal="out"]',
      );
      if (!hidden) return;
      observer.unobserve(hidden);
      show(hidden, 0);
    });
  }

  /*
   * Lettered headings. The words are split into one span per letter inside
   * a copy that assistive technology skips; the heading's own text is kept
   * whole beside it for screen readers.
   */
  if (able) {
    /* Each letter takes LETTER to come up; a whole heading starts within SPREAD. */
    const LETTER = 900;
    const STEP = 32;
    const SPREAD = 1400;

    const split = (element: HTMLElement) => {
      const whole = document.createElement("span");
      whole.className = "sr-only";
      whole.textContent = element.textContent;

      const visual = document.createElement("span");
      visual.className = "reveal-letters_visual";
      visual.setAttribute("aria-hidden", "true");
      visual.append(...element.childNodes);

      const walker = document.createTreeWalker(visual, NodeFilter.SHOW_TEXT);
      const texts: Text[] = [];
      while (walker.nextNode()) texts.push(walker.currentNode as Text);

      let count = 0;
      for (const text of texts) {
        const pieces = document.createDocumentFragment();
        /* Spaces stay plain text, so the lines break where they did before. */
        for (const part of text.data.match(/\s+|\S+/g) ?? []) {
          if (/^\s+$/.test(part)) {
            pieces.append(part);
            continue;
          }
          for (const letter of Array.from(part)) {
            const span = document.createElement("span");
            span.className = "reveal-letters_letter";
            span.style.setProperty("--_i", String(count++));
            span.textContent = letter;
            pieces.append(span);
          }
        }
        text.replaceWith(pieces);
      }

      element.replaceChildren(whole, visual);
      const step = Math.min(STEP, SPREAD / Math.max(count, 1));
      element.style.setProperty("--_letter-step", `${step}ms`);
      element.style.setProperty("--_letter-duration", `${LETTER}ms`);
      return count * step + LETTER;
    };

    const lengths = new Map<Element, number>();

    const write = (element: HTMLElement) => {
      if (element.dataset.letters !== "out") return;
      element.dataset.letters = "in";
      window.setTimeout(
        () => {
          element.dataset.letters = "done";
        },
        (lengths.get(element) ?? 0) + 100,
      );
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          write(entry.target as HTMLElement);
        }
      },
      { rootMargin: ROOT_MARGIN, threshold: 0 },
    );

    for (const element of lettered) {
      lengths.set(element, split(element));
      element.dataset.letters = "out";
      observer.observe(element);
    }
  } else {
    for (const element of lettered) element.dataset.letters = "off";
  }
</script>

<style is:global>
  @layer components {
    /* Hidden at once, while still off screen; only the way in is animated. */
    [data-reveal="out"] {
      opacity: 0;
      translate: 0 1.5rem;
    }

    [data-reveal="in"] {
      --_reveal-ease: cubic-bezier(0.22, 1, 0.36, 1);
      transition:
        opacity 840ms var(--_reveal-ease),
        translate 1080ms var(--_reveal-ease);
    }

    /*
     * A lettered heading waits unseen for the script to split it. Should the
     * script never come, it shows itself after a moment all the same.
     */
    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
      [data-reveal-letters]:not([data-letters]) {
        animation: reveal-letters-late 400ms 2.5s both;
      }
    }

    [data-letters="out"] .reveal-letters_letter {
      opacity: 0;
    }

    /* Each letter fades up on its own, so a soft edge of white runs along the line. */
    [data-letters="in"] .reveal-letters_letter {
      animation: reveal-letter var(--_letter-duration, 900ms)
        cubic-bezier(0.33, 0, 0.2, 1) both;
      animation-delay: calc(var(--_i, 0) * var(--_letter-step, 32ms));
    }

    @keyframes reveal-letter {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes reveal-letters-late {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @media print {
      [data-reveal] {
        opacity: 1;
        translate: none;
      }
      [data-reveal-letters]:not([data-letters]),
      [data-reveal-letters] .reveal-letters_letter {
        opacity: 1;
        animation: none;
      }
    }
  }
</style>
