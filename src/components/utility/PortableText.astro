---
import { PortableText as Renderer } from "astro-portabletext";
import Ornament from "@/components/media/Ornament.astro";
import PortableHeading from "@/components/utility/PortableHeading.astro";
import PortableImage from "@/components/utility/PortableImage.astro";
import { levelHeadings } from "@/utils/headings.ts";
import { listedSegments } from "@/utils/text-blocks.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Portable Text blocks from Sanity. */
  value?: unknown[];
  /**
   * Maximum line length in characters. Omit to fill the column.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const { render = true, value, maxWidth } = Astro.props;

const components = {
  type: { imageWithAlt: PortableImage },
  block: {
    h2: PortableHeading,
    h3: PortableHeading,
    h4: PortableHeading,
    h5: PortableHeading,
    h6: PortableHeading,
  },
};

/* A renumbered heading remembers the style the editor gave it. */
const original = (value ?? []) as { style?: string }[];
const blocks = levelHeadings(original).map((block, index) =>
  block === original[index]
    ? block
    : { ...block, look: original[index]?.style },
);
const segments = listedSegments(blocks);
---

{render && blocks.length > 0 && (
  <div
    class="portable-text_wrap text-style-large"
    style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
  >
    {segments.map((segment) =>
      segment.kind === "text" ? (
        <Renderer value={segment.blocks as never} components={components} />
      ) : (
        <div class="portable-text_listed">
          <div class="portable-text_label">
            <Renderer value={[segment.label] as never} components={components} />
          </div>
          <Renderer value={segment.items as never} components={components} />
          <div class="portable-text_mark">
            <Ornament variant={2} />
          </div>
        </div>
      ),
    )}
  </div>
)}

<style is:global>
  @layer components {
    /*
     * Text an editor wrote, spaced as the design's text pages are at 402 and
     * at 1920: 21px between paragraphs and 22px between list items at 1920,
     * 8px and 14px on a phone, measured from line to line. On a phone the
     * text sits 1rem in from the rules and photographs.
     */
    .portable-text_wrap {
      --_inset: 0rem;
      --_paragraph: clamp(1.2312rem, 0.935rem + 1.1792vw, 2.35rem);
      --_item: clamp(1.6062rem, 1.3927rem + 0.8498vw, 2.4125rem);
      --_after-title: clamp(3.375rem, 2.895rem + 1.9104vw, 5.1875rem);
      --_after-heading: clamp(1.9187rem, 1.5166rem + 1.6008vw, 3.4375rem);
      --_before-heading: clamp(4.2687rem, 3.0737rem + 4.7563vw, 8.7813rem);
      --_figure: clamp(2.5rem, 1.8744rem + 2.4901vw, 4.8625rem);
      width: 100%;
      max-width: var(--_mw, none);
      padding-inline: var(--_inset);
      line-height: clamp(1.45rem, 1.3209rem + 0.5138vw, 1.9375rem);
      text-align: start;
      @media (width < 48rem) {
        --_inset: 1rem;
      }

      & > * {
        margin-block: 0;
      }
      & > * + * {
        margin-top: var(--_paragraph);
      }
      & > :is(figure, .portable-text_listed) {
        margin-inline: calc(-1 * var(--_inset));
      }
      & > * + figure,
      & > figure + * {
        margin-top: var(--_figure);
      }
      & > * + .portable-text_listed {
        margin-top: 3.125rem;
      }
      & > .portable-text_listed + * {
        margin-top: clamp(3.3rem, 4.3119rem + -0.8432vw, 4.1rem);
      }
      & > * + .portable-text_heading {
        margin-top: var(--_before-heading);
      }
      & > .portable-text_heading + * {
        margin-top: var(--_after-heading);
      }
      & > .portable-text_heading.text-style-h3 + * {
        margin-top: var(--_after-title);
      }

      & li {
        text-box: trim-both cap alphabetic;
      }
      & li + li,
      & li > :is(ul, ol) {
        margin-top: var(--_item);
      }
      & :is(ul, ol) {
        padding-left: 1em;
        @media (width >= 48rem) {
          padding-left: 1.5em;
        }
      }
      & ul {
        list-style-type: disc;
      }
      & ul ul {
        list-style-type: circle;
      }
      & ol {
        list-style-type: decimal;
      }
      & li::marker {
        color: currentcolor;
      }

      & blockquote {
        padding-left: var(--space-4);
        border-left: var(--border-width) solid var(--text);
      }
    }

    /*
     * The largest heading the editor can pick breaks where the design breaks
     * it, half the column wide, and keeps the design's leading on two lines.
     */
    .portable-text_heading.text-style-h3 {
      max-width: 14.75em;
      line-height: clamp(1.95rem, 1.7017rem + 0.9881vw, 2.8875rem);
      text-wrap: wrap;
    }

    /*
     * A list with the line that introduces it, between rules: the line on the
     * left from 48rem with the ornament under it, the list on the right.
     */
    .portable-text_listed {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      padding: 3.3rem var(--_inset) 1.6rem;
      border-block: var(--border-width) solid var(--text);

      & > ul,
      & > ol {
        margin-top: 2.2937rem;
      }
      @media (width >= 48rem) {
        grid-template-columns: 32% minmax(0, 1fr);
        grid-template-rows: auto 1fr;
        padding-bottom: clamp(1.6rem, 1.1664rem + 1.726vw, 3.2375rem);

        & > ul,
        & > ol {
          grid-column: 2;
          grid-row: 1 / 3;
          margin-top: 0;
        }
      }
    }

    .portable-text_label {
      font-weight: var(--primary-bold);
      @media (width >= 48rem) {
        grid-column: 1;
        grid-row: 1;
        padding-inline-end: var(--site-gutter);
      }
    }

    .portable-text_mark {
      margin-top: 5.0625rem;
      @media (width >= 48rem) {
        --_alignment: flex-start;
        grid-column: 1;
        grid-row: 2;
        align-self: end;
        margin: 0 0 -0.6625rem;
      }
    }
  }
</style>
