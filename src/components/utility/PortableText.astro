---
import { PortableText as Renderer } from "astro-portabletext";
import RichText from "@/components/typography/RichText.astro";
import PortableImage from "@/components/utility/PortableImage.astro";
import { levelHeadings } from "@/utils/headings.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Portable Text blocks from Sanity. */
  value?: unknown[];
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const { render = true, value, maxWidth = 75 } = Astro.props;

const components = { type: { imageWithAlt: PortableImage } };
const blocks = levelHeadings(value ?? []);
---

{render && blocks.length > 0 && (
  <RichText maxWidth={maxWidth}>
    <Renderer value={blocks as never} components={components} />
  </RichText>
)}
