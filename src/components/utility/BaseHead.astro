---
import { Font } from "astro:assets";
import {
  DEFAULT_LANG,
  LANG_LOCALES,
  SITE_NAME,
  SITE_DESCRIPTION,
} from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
  alternates = [],
} = Astro.props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const pathname = Astro.locals.pathname ?? Astro.url.pathname;
const isNoindex = noindex ?? isNoindexRoute(pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const defaultAlternate = alternates.find((item) => item.lang === DEFAULT_LANG);

/*
 * Romie is configured only when its files are present, so its variable is
 * not in the type Astro generates on a machine without them.
 */
const romie = { cssVariable: "--font-romie" } as unknown as {
  cssVariable: "--font-manrope";
};
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-manrope" preload />
{import.meta.env.HAS_ROMIE && <Font {...romie} preload />}
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}
{!isNoindex &&
  alternates.map((item) => (
    <link
      rel="alternate"
      hreflang={item.lang}
      href={new URL(item.path, Astro.site)}
    />
  ))}
{!isNoindex && defaultAlternate && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={new URL(defaultAlternate.path, Astro.site)}
  />
)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={LANG_LOCALES[lang].replace("-", "_")} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
