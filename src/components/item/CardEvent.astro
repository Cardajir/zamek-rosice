---
import Button from "@/components/Button.astro";
import SanityImg from "@/components/media/SanityImg.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Line above the title: "Aktuality" or "Akce". */
  eyebrow?: string;
  /** Card title. */
  heading: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4";
  /** Line in bold above the text, such as the admission. */
  lead?: string;
  /** Body text. */
  text?: string;
  /** Link destination. */
  href: string;
  /** Button label. */
  buttonLabel: string;
  /** Day and month of the event, as shown on the right. */
  date?: string;
  /** Year of the event. */
  year?: string;
  /** Machine-readable date for the `<time>` element. */
  datetime?: string;
  /** Image source. */
  image?: string;
  /** Image alt text. Omit for decorative images. */
  imageAlt?: string;
  /** Image width. */
  imageWidth?: number;
  /** Image height. */
  imageHeight?: number;
  /** Card layout: a row in the list, or the large pinned item above it. */
  variant?: "main" | "featured";
}

const {
  render = true,
  eyebrow,
  heading,
  headingTag: Tag = "h3",
  lead,
  text,
  href,
  buttonLabel,
  date,
  year,
  datetime,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  variant = "main",
} = Astro.props;

const featured = variant === "featured";
---

{render && heading && (
  <article class:list={["card-event_wrap", featured && "featured"]}>
    <div class:list={["card-event_visual", !image && "is-empty"]}>
      {image && (
        <SanityImg
          image={{
            url: image,
            alt: imageAlt,
            width: imageWidth,
            height: imageHeight,
          }}
          sizes={featured ? "(width >= 48rem) 40vw, 100vw" : "11rem"}
          maxWidth={featured ? 1600 : 1200}
        />
      )}
    </div>
    <div class="card-event_content">
      <p class="card-event_eyebrow text-style-main">{eyebrow}</p>
      <Tag class="card-event_title text-style-h3">
        <a class="card-event_title_link link-underline" href={href}>
          {heading}
        </a>
      </Tag>
      {lead && <p class="card-event_lead text-style-main">{lead}</p>}
      {text && <p class="card-event_text text-style-main">{text}</p>}
    </div>
    <div class="card-event_aside">
      {date && !featured && (
        <time class="card-event_date" datetime={datetime}>
          <span class="card-event_year text-style-small">{year}</span>
          <span class="card-event_day text-style-h3">{date}</span>
        </time>
      )}
      <Button
        element="link"
        variant="link"
        href={href}
        aria-hidden="true"
        tabindex={-1}
      >
        {buttonLabel}
      </Button>
    </div>
  </article>
)}

<style is:global>
  @layer components {
    /*
     * Spacing is measured from the rule to the capitals and from the
     * baseline to the next capitals, as the text is trimmed to its letters.
     * On a phone everything stacks: the eyebrow with the date beside it,
     * the poster, the title, the text and the link. From 48rem the poster,
     * the text and the date sit side by side.
     */
    .card-event_wrap {
      --_inset: clamp(1rem, 0.6524rem + 1.3834vw, 2.3125rem);
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "eyebrow date"
        "visual visual"
        "title title"
        "lead lead"
        "text text"
        "button button";
      align-items: end;
      column-gap: var(--space-4);
      padding: clamp(2rem, 1.9338rem + 0.2635vw, 2.25rem) var(--_inset)
        1.5rem;
      border-top: var(--border-width) solid var(--text);

      @media (width >= 48rem) {
        grid-template-columns: 11rem 1fr auto;
        grid-template-areas: "visual content aside";
        align-items: stretch;
        column-gap: var(--space-8);
        padding-bottom: clamp(1.5rem, 1.2848rem + 0.8564vw, 2.3125rem);
      }
    }

    .card-event_visual {
      grid-area: visual;
      justify-self: start;
      width: 9rem;
      margin-top: 1.5rem;
      background-color: var(--background-2);
      overflow: clip;

      & > .image {
        display: block;
        width: 100%;
        height: auto;
      }

      /* A news item without a picture leaves the column empty on a phone. */
      &.is-empty {
        display: none;
      }

      @media (width >= 48rem) {
        width: 100%;
        aspect-ratio: 177 / 223;
        align-self: start;
        margin-top: 0;

        &.is-empty {
          display: block;
        }

        & > .image {
          height: 100%;
          object-fit: cover;
        }
      }
    }

    .card-event_content {
      display: contents;

      @media (width >= 48rem) {
        grid-area: content;
        display: flex;
        flex-direction: column;
        align-items: start;
        max-width: 42rem;
        padding-top: 0.3rem;
      }
    }

    .card-event_eyebrow {
      grid-area: eyebrow;
      margin: 0;
      color: var(--muted-text);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      line-height: 1.2;

      @media (width >= 48rem) {
        font-size: var(--text-main);
      }
    }

    .card-event_title {
      grid-area: title;
      margin: 1.75rem 0 0;
      text-wrap: balance;

      @media (width >= 48rem) {
        margin-top: clamp(1.5rem, 1.4172rem + 0.3294vw, 1.8125rem);
      }
    }

    /* The whole card is the title's link; its underline is the site's own. */
    .card-event_title_link {
      &::after {
        content: "";
        position: absolute;
        inset: 0;
      }
    }

    .card-event_lead,
    .card-event_text {
      margin: clamp(2rem, 1.6028rem + 1.581vw, 3.5rem) 0 0;
      font-size: var(--text-small);

      @media (width >= 48rem) {
        font-size: var(--text-main);
      }
    }

    .card-event_lead {
      grid-area: lead;
      font-weight: var(--primary-bold);
    }

    .card-event_text {
      grid-area: text;
    }

    .card-event_lead + .card-event_text {
      margin-top: clamp(0.5938rem, 0.132rem + 1.8379vw, 2.3375rem);
    }

    .card-event_aside {
      display: contents;

      & > .button_wrap {
        grid-area: button;
        justify-self: start;
        margin-top: 1.875rem;
        transition: opacity var(--hover-duration) var(--hover-ease);
      }

      @media (width >= 48rem) {
        grid-area: aside;
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: space-between;
        gap: var(--space-4);
        text-align: end;

        /* Bottom right, with a date above it or without one. */
        & > .button_wrap {
          margin-top: auto;
        }
      }
    }

    /* Beside the eyebrow on a phone; above, in the large title size, from 48rem. */
    .card-event_date {
      grid-area: date;
      display: flex;
      flex-direction: row-reverse;
      align-items: end;
      gap: 0.75rem;
      white-space: nowrap;

      @media (width >= 48rem) {
        flex-direction: column;
        gap: clamp(1.25rem, 1.1176rem + 0.527vw, 1.75rem);
        padding-top: 0.15rem;
      }
    }

    .card-event_year {
      color: var(--muted-text);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      letter-spacing: var(--letter-spacing-wide);
      line-height: 1.2;

      @media (width >= 48rem) {
        font-weight: var(--primary-semibold);
        letter-spacing: var(--letter-spacing-snug);
      }
    }

    .card-event_day {
      font-size: 1.0625rem;

      @media (width >= 48rem) {
        font-size: var(--h3);
      }
    }

    /* Below 48rem the link is always shown; from there it waits for a hover. */
    @media (width >= 48rem) and (hover: hover) {
      .card-event_wrap:not(.featured) .card-event_aside > .button_wrap {
        opacity: 0;
      }
      .card-event_wrap:hover .card-event_aside > .button_wrap {
        opacity: 1;
      }
    }

    /* Hovering anywhere on the card draws the title's underline. */
    @media (hover: hover) {
      .card-event_wrap:hover .card-event_title_link {
        background-position-x: 0%;
        background-size: 100% var(--link-underline-width);
      }
    }

    .card-event_wrap:focus-within .card-event_aside > .button_wrap {
      opacity: 1;
    }

    /* ---------------------------------------------------------- featured -- */

    /*
     * The pinned item: a large photograph, then the text. From 48rem the
     * photograph takes the left half and the text sits centred beside it.
     */
    .card-event_wrap.featured {
      grid-template-columns: 1fr;
      grid-template-areas:
        "visual"
        "eyebrow"
        "title"
        "lead"
        "text"
        "button";
      padding-top: clamp(2rem, 1.4373rem + 2.2398vw, 4.125rem);
      padding-bottom: 1.375rem;

      & .card-event_visual {
        width: 100%;
        margin-top: 0;
        aspect-ratio: 339 / 316;

        & > .image {
          height: 100%;
          object-fit: cover;
        }
      }

      & .card-event_eyebrow {
        margin-top: 2.3125rem;
      }

      & .card-event_title {
        margin-top: 1.9375rem;
      }

      @media (width >= 48rem) {
        grid-template-columns: 758fr 181fr 505fr 125fr;
        grid-template-rows: 1fr auto auto 1fr;
        grid-template-areas:
          "visual . . ."
          "visual . content ."
          "visual . aside ."
          "visual . . .";
        column-gap: 0;
        padding-bottom: clamp(1.375rem, 0.7792rem + 2.3715vw, 3.625rem);

        & .card-event_visual {
          aspect-ratio: 758 / 613;
        }

        & .card-event_content {
          max-width: none;
          padding-top: 0;
        }

        & .card-event_eyebrow {
          margin-top: 0;
        }

        & .card-event_title {
          margin-top: clamp(1.9375rem, 1.772rem + 0.6588vw, 2.5625rem);
        }

        & .card-event_lead,
        & .card-event_text {
          margin-top: clamp(2rem, 1.8212rem + 0.7115vw, 2.675rem);
        }

        & .card-event_aside {
          align-items: start;
          text-align: start;

          & > .button_wrap {
            margin-top: 1.875rem;
          }
        }
      }
    }
  }
</style>
