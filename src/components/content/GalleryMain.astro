---
import Icon from "@/components/media/Icon.astro";
import Ornament from "@/components/media/Ornament.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import { DEFAULT_LANG } from "@/consts.ts";
import { ui } from "@/i18n/ui.ts";
import type { Image } from "@/sanity/queries.ts";
import { scaled, sized } from "@/utils/image.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Photographs, in the order they are shown. */
  photos: Image[];
  /** Address of the album list, for the link back to it under the photographs. */
  back?: string;
  /** Anchor the album links scroll to, landing on the first photograph. */
  id?: string;
  /** Class names for utilities. */
  class?: string;
}

const { render = true, photos, back, id, class: className } = Astro.props;

const t = ui(Astro.locals.lang ?? DEFAULT_LANG);

/* Phone thumbnails are about 164px wide, so the small steps matter there. */
const THUMB_WIDTHS = [320, 480, 640, 800, 1200];
const FULL_WIDTHS = [800, 1200, 1600, 2400];

const srcset = (photo: Image, widths: number[]) =>
  widths
    .filter((width, index) => index === 0 || width <= (photo.width || Infinity))
    .map((width) => `${sized(photo.url, width)} ${width}w`)
    .join(", ");

/* Authors and copyright, said once in small print under the whole gallery. */
const credits = [
  ...new Set(photos.map((photo) => photo.credit).filter(Boolean)),
];

const items = photos.map((photo, index) => ({
  photo,
  /* A photograph with no description is still a link that says what it does. */
  name: photo.alt || photo.caption || `${t.enlargePhoto} ${index + 1}`,
  size: scaled(photo, 1200),
}));

/*
 * Two columns on a phone leave a hole after the wide first photograph when
 * the rest are odd in number; the design fills it with the rose.
 */
const filler = (items.length - 1) % 2 === 1;
---

{render && items.length > 0 && (
  <div class:list={["gallery_wrap", className]} id={id}>
    <ul class="gallery_list" role="list">
      {items.map(({ photo, name, size }, index) => (
        <li class="gallery_item">
          <figure class:list={["gallery_figure", !photo.caption && "is-bare"]}>
            <a
              class="gallery_link"
              href={sized(photo.url, 2400)}
              aria-label={`${t.enlargePhoto}: ${name}`}
              data-gallery-open={index}
              data-srcset={srcset(photo, FULL_WIDTHS)}
              data-alt={photo.alt ?? photo.caption ?? ""}
              data-note={photo.caption ?? ""}
            >
              <img
                class="gallery_thumb"
                src={sized(photo.url, 800)}
                srcset={srcset(photo, THUMB_WIDTHS)}
                sizes={
                  index === 0
                    ? "(width >= 82rem) 82rem, 100vw"
                    : "(width >= 64rem) 27rem, calc(50vw - 2.5rem)"
                }
                width={size.width}
                height={size.height}
                alt={photo.alt ?? photo.caption ?? ""}
                loading="lazy"
                decoding="async"
              />
            </a>
            {photo.caption && (
              <figcaption class="gallery_note">{photo.caption}</figcaption>
            )}
          </figure>
        </li>
      ))}
      {filler && (
        <li class="gallery_item gallery_filler" aria-hidden="true">
          <Ornament variant={5} />
        </li>
      )}
    </ul>

    {(back || credits.length > 0) && (
      <div class="gallery_end">
        {back && (
          <a class="gallery_back" href={back}>
            <span class="gallery_back-mark">
              <Icon src={arrow} variant="small" />
            </span>
            <span class="gallery_back-text link-underline">
              {t.backToAlbums}
            </span>
          </a>
        )}
        {credits.length > 0 && (
          <p class="gallery_credits">{credits.join(" · ")}</p>
        )}
      </div>
    )}

    <dialog class="gallery_viewer" aria-label={t.photoViewer}>
      <button
        class="gallery_close"
        type="button"
        aria-label={t.closeViewer}
        data-gallery-close
      >
        <svg
          class="gallery_close-mark"
          viewBox="0 0 14 14"
          width="14"
          height="14"
          aria-hidden="true"
        >
          <path
            d="M1.4 14 0 12.6 5.6 7 0 1.4 1.4 0 7 5.6 12.6 0 14 1.4 8.4 7l5.6 5.6-1.4 1.4L7 8.4 1.4 14Z"
            fill="currentColor"
          />
        </svg>
      </button>
      <button
        class="gallery_step is-back"
        type="button"
        aria-label={t.previousPhoto}
        data-gallery-step="-1"
      >
        <span class="gallery_step-mark">
          <Icon src={arrow} variant="small" />
        </span>
      </button>
      <button
        class="gallery_step is-forward"
        type="button"
        aria-label={t.nextPhoto}
        data-gallery-step="1"
      >
        <span class="gallery_step-mark">
          <Icon src={arrow} variant="small" />
        </span>
      </button>
      <figure class="gallery_stage">
        <div class="gallery_frame">
          <img
            class="gallery_photo"
            alt=""
            sizes="(width >= 48rem) min(83rem, 100vw - 15rem), 100vw"
            decoding="async"
          />
        </div>
        <figcaption class="gallery_caption">
          <span class="gallery_count" aria-live="polite" />
          <span class="gallery_text" />
        </figcaption>
      </figure>
    </dialog>
  </div>
)}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>(
    ".gallery_wrap",
  )) {
    const viewer = gallery.querySelector<HTMLDialogElement>(".gallery_viewer");
    const photo = gallery.querySelector<HTMLImageElement>(".gallery_photo");
    const count = gallery.querySelector<HTMLElement>(".gallery_count");
    const text = gallery.querySelector<HTMLElement>(".gallery_text");
    const links = [
      ...gallery.querySelectorAll<HTMLAnchorElement>("[data-gallery-open]"),
    ];
    if (!viewer || !photo || !count || !text || links.length === 0) continue;

    let current = 0;

    /* The next photograph is fetched while the visitor looks at this one. */
    const preload = (index: number) => {
      const link = links[(index + links.length) % links.length];
      if (!link) return;
      const next = new Image();
      next.sizes = photo.sizes;
      next.srcset = link.dataset.srcset ?? "";
      next.src = link.href;
    };

    const show = (index: number, step = 1) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      if (!link) return;
      photo.srcset = link.dataset.srcset ?? "";
      photo.src = link.href;
      photo.alt = link.dataset.alt ?? "";
      count.textContent = `${current + 1}/${links.length}`;
      text.textContent = link.dataset.note ?? "";
      preload(current + step);
    };

    for (const [index, link] of links.entries()) {
      link.addEventListener("click", (event) => {
        /* A click meant for a new tab or window is left to the browser. */
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
          return;
        }
        event.preventDefault();
        show(index);
        viewer.showModal();
      });
    }

    /* Only a press that starts and ends on the dark surround closes it. */
    let fromBackdrop = false;
    viewer.addEventListener("pointerdown", (event) => {
      fromBackdrop = event.target === viewer;
    });

    viewer.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const step = target.closest<HTMLElement>("[data-gallery-step]");
      if (step) {
        const by = Number(step.dataset.galleryStep);
        show(current + by, by);
      } else if (target.closest("[data-gallery-close]")) viewer.close();
      else if (fromBackdrop && target === viewer) viewer.close();
      fromBackdrop = false;
    });

    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1, -1);
      else if (event.key === "ArrowRight") show(current + 1);
    });

    /* A swipe across the photograph turns the page. */
    let startX: number | undefined;
    photo.addEventListener("pointerdown", (event) => {
      startX = event.pointerType === "touch" ? event.clientX : undefined;
    });
    photo.addEventListener("pointerup", (event) => {
      if (startX === undefined) return;
      const moved = event.clientX - startX;
      startX = undefined;
      if (Math.abs(moved) > 40) {
        const by = moved < 0 ? 1 : -1;
        show(current + by, by);
      }
    });

    /* Focus goes back to the photograph the visitor was last looking at. */
    viewer.addEventListener("close", () => {
      photo.removeAttribute("srcset");
      photo.removeAttribute("src");
      links[current]?.focus();
    });
  }
</script>

<style is:global>
  @layer components {
    html:has(.gallery_viewer[open]) {
      overflow: hidden;
    }

    /*
     * 1312px wide at 1920. On a phone the photographs sit a further 17px in
     * from the page edge, like the cards elsewhere.
     */
    .gallery_wrap {
      /* An album link lands here, the first photograph just under the bar. */
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
      --_note-size: clamp(0.75rem, 0.6506rem + 0.3953vw, 1.125rem);
      --_note-gap: clamp(0.6875rem, 0.4889rem + 0.7905vw, 1.4375rem);

      width: 100%;
      max-width: var(--max-width-small);
      margin-inline: auto;
      padding-inline: 1.0625rem;
      @media (width >= 48rem) {
        padding-inline: 0;
      }
    }

    /*
     * 17px between columns on a phone, 22px at 1920. A photograph starts
     * 208px under the one above on a phone and 449px at 1920 (102px under
     * it), its description or the room kept for one in between.
     */
    /*
     * No list marker at all: Safari lays the reset's empty marker on a line of
     * its own above a flex or grid item and pushes it down. role="list" keeps
     * the list for VoiceOver.
     */
    .gallery_list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.4375rem, 0.8582rem + 2.3057vw, 3.625rem)
        clamp(1.0625rem, 0.9797rem + 0.3294vw, 1.375rem);
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    /*
     * The wide first photograph: the next row starts 60px under it on a
     * phone and 81px at 1920, closer than the rows below on a large screen.
     */
    .gallery_item:first-child {
      grid-column: 1 / -1;
      margin-block-end: clamp(-1.3125rem, 1.2962rem - 2.1739vw, 0.75rem);
    }

    .gallery_figure {
      display: flex;
      flex-direction: column;
      gap: var(--_note-gap);
      margin: 0;

      /* No description: the same room is kept, so the rows stay even. */
      &.is-bare {
        padding-block-end: calc(var(--_note-gap) + var(--_note-size) * 1.2);
      }
    }

    .gallery_link {
      display: block;
      overflow: clip;
      background-color: var(--background-2);
    }

    .gallery_thumb {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: scale var(--hover-duration) var(--hover-ease);
      @media (width >= 64rem) {
        aspect-ratio: 423 / 347;
      }

      .gallery_item:first-child & {
        aspect-ratio: 337 / 241;
        @media (width >= 48rem) {
          aspect-ratio: 1312 / 670;
        }
      }

      @media (hover: hover) {
        .gallery_link:hover & {
          scale: 1.03;
        }
      }
    }

    /* The description under a photograph: 12px on a phone, 18px at 1920. */
    .gallery_note {
      color: var(--text);
      font-size: var(--_note-size);
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      text-align: end;
    }

    /* The rose in the hole the odd photograph leaves; three columns have none. */
    .gallery_filler {
      display: grid;
      align-content: center;
      aspect-ratio: 1 / 1;
      @media (width >= 64rem) {
        display: none;
      }
    }

    /*
     * The link back to the albums, and the authors in small print at the
     * other end of the same line, the only place they are named.
     */
    .gallery_end {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3) var(--space-6);
      /* 132px under the last description on a phone, 127px at 1920. */
      margin-block-start: clamp(6.9125rem, 7.3077rem - 0.3294vw, 7.225rem);
      /* The footer's rule 36px under the last line on a phone, 44px at 1920. */
      padding-block-end: clamp(1.65rem, 2.4089rem - 0.6324vw, 2.25rem);
    }

    .gallery_credits {
      flex: 1 1 18rem;
      color: var(--muted-text);
      font-size: clamp(0.75rem, 0.6837rem + 0.2635vw, 1rem);
      line-height: 1.2;
      text-align: end;
    }

    /*
     * The serif link back up to the album list, as the design draws it; the
     * site's shared underline runs under the words only.
     */
    .gallery_back {
      display: inline-flex;
      align-items: center;
      gap: 0.54em;
      margin-inline-start: -1.0625rem;
      padding-block: 0.4em;
      color: var(--link-text);
      font-family: var(--secondary-family);
      font-size: var(--text-button);
      font-style: italic;
      font-weight: var(--secondary-medium);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      text-decoration: none;
      @media (width >= 48rem) {
        margin-inline-start: 0;
      }
    }

    .gallery_back-mark {
      display: flex;
      font-size: 0.8333em;
      rotate: -90deg;
    }

    /*
     * The viewer dims the page to a quarter. On a phone the site's bar stays
     * clear above it, as in the design; tapping it or the dark surround closes.
     */
    .gallery_viewer {
      /* Room for the cross above the photograph on a phone. */
      --_top: 2.75rem;
      --_bottom: 6.1875rem;
      --_side: var(--site-gutter);
      --_bar: var(--nav-height, 5.25rem);

      inset: var(--_bar) 0 0;
      width: 100%;
      max-width: none;
      height: auto;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      overflow: hidden;
      background: transparent;
      color: #fff;

      &::backdrop {
        background: linear-gradient(
          transparent var(--nav-height, 5.25rem),
          rgb(0 0 0 / 0.75) var(--nav-height, 5.25rem)
        );
      }

      @media (width >= 48rem) {
        --_top: 2.875rem;
        --_bottom: 7.6875rem;
        --_side: max(7.5rem, (100% - 83rem) / 2);
        --_bar: 0rem;

        &::backdrop {
          background: rgb(0 0 0 / 0.75);
        }
      }
    }

    .gallery_stage {
      position: absolute;
      inset: 0;
      margin: 0;
      pointer-events: none;
    }

    /*
     * The photograph, whole, as large as the space between the controls
     * allows. A flex box, not a grid: a grid's auto row grows with a tall
     * photograph, so its height limit never held and portraits ran off the
     * screen; here it is measured against the frame's own fixed height.
     */
    .gallery_frame {
      position: absolute;
      inset: var(--_top) var(--_side) var(--_bottom);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gallery_photo {
      flex: none;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      pointer-events: auto;
      user-select: none;
      touch-action: pan-y;
    }

    /*
     * The count and the description, bottom left: stacked on a phone, side by
     * side from a tablet, the description on the page's own left edge.
     */
    .gallery_caption {
      position: absolute;
      inset: auto 7.5rem 1.6875rem var(--site-gutter);
      display: grid;
      gap: 0.5rem;
      font-size: clamp(0.75rem, 0.6506rem + 0.3953vw, 1.125rem);
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);
      white-space: pre-line;
      @media (width >= 48rem) {
        inset: auto var(--_side) 2.25rem 2.1875rem;
        grid-template-columns: 6.375rem minmax(0, 1fr);
        align-items: end;
        gap: 0;
      }
    }

    .gallery_text:empty {
      display: none;
    }

    .gallery_close,
    .gallery_step {
      position: absolute;
      z-index: 1;
      display: grid;
      place-items: center;
      padding: 0.625rem;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }

    /* A cross, top right, above the photograph. */
    .gallery_close {
      inset: 0.375rem 0.375rem auto auto;
      @media (width >= 48rem) {
        inset: 2.5625rem 2.375rem auto auto;
      }
    }

    .gallery_close-mark {
      display: block;
      width: 0.875rem;
      height: auto;
    }

    /* 25px arrows bottom right on a phone, 40px at the sides at 1920. */
    .gallery_step {
      inset: auto 0.375rem 0.9375rem auto;
      &.is-back {
        inset-inline-end: 3.1875rem;
      }
      @media (width >= 48rem) {
        inset: 50% auto auto 1.5625rem;
        translate: 0 -50%;
        &.is-forward {
          inset-inline: auto 2.25rem;
        }
      }
      &.is-back {
        @media (width >= 48rem) {
          inset-inline-end: auto;
        }
      }
    }

    .gallery_step-mark {
      display: flex;
      font-size: 1.5625rem;
      @media (width >= 48rem) {
        font-size: 2.5rem;
      }

      .is-back > & {
        rotate: 180deg;
      }
    }
  }
</style>
