---
import { DEFAULT_LANG, formatPhone } from "@/consts.ts";
import { ui } from "@/i18n/ui.ts";
import type { Shell } from "@/sanity/queries.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The castle's telephone numbers and e-mail address. */
  shell: Pick<Shell, "phone" | "mobile" | "email">;
  /** `large` sets the lines at heading 2, as on the contact page. */
  size?: "default" | "large";
  /** Class names for utilities. */
  class?: string;
}

const { render = true, shell, size = "default", class: className } = Astro.props;

const t = ui(Astro.locals.lang ?? DEFAULT_LANG);
const tel = (value: string) => `tel:${value.replace(/[^\d+]/g, "")}`;
const shown = shell.mobile || shell.phone || shell.email;
---

{render && shown && (
  <address
    class:list={[
      "contact-lines_wrap",
      size === "large" ? "text-style-h2 large" : "text-style-h3",
      className,
    ]}
  >
    {shell.mobile && (
      <a class="contact-lines_link" href={tel(shell.mobile)}>
        <span class="link-underline">
          {t.mobileShort}: {formatPhone(shell.mobile)}
        </span>
      </a>
    )}
    {shell.phone && (
      <a class="contact-lines_link" href={tel(shell.phone)}>
        <span class="link-underline">
          {t.phoneShort}: {formatPhone(shell.phone)}
        </span>
      </a>
    )}
    {shell.email && (
      <a class="contact-lines_link" href={`mailto:${shell.email}`}>
        <span class="link-underline">{shell.email}</span>
      </a>
    )}
  </address>
)}

<style is:global>
  @layer components {
    .contact-lines_wrap {
      display: flex;
      flex-direction: column;
      align-items: start;
      font-style: normal;
      line-height: var(--line-height-large);

      /* 64px lines, 8px apart. */
      &.large {
        gap: 0.5rem;
        line-height: 1.1;
      }
    }

    .contact-lines_link {
      text-decoration: none;
      overflow-wrap: anywhere;
    }
  }
</style>
