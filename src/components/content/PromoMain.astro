---
import Button from "@/components/Button.astro";
import putto from "@/assets/ornaments/ornament-7.svg";
import SanityImg from "@/components/media/SanityImg.astro";
import type { Promo } from "@/sanity/queries.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Eyebrow, title, text, photographs and link. */
  promo: Promo;
  /** Heading level. */
  headingTag?: "h2" | "h3";
  /** Put the text on the right and the photographs on the left. */
  reverse?: boolean;
  /** A pale putto behind the text, from 64rem up. */
  backdrop?: boolean;
}

const {
  render = true,
  promo,
  headingTag: Tag = "h2",
  reverse = false,
  backdrop = false,
} = Astro.props;

const images = promo.images.slice(0, 2);
/* A line break in the Studio's text field starts a new paragraph. */
const paragraphs = (promo.text ?? "")
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

{render && promo.title && (
  <article
    class:list={[
      "promo_wrap",
      reverse && "reverse",
      images.length === 0 && "text-only",
    ]}
  >
    <div class="promo_content">
      {backdrop && (
        <img
          class="promo_backdrop"
          src={putto.src}
          width="644"
          height="566"
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
      {promo.eyebrow && <p class="promo_eyebrow">{promo.eyebrow}</p>}
      <Tag class="promo_title text-style-h3">{promo.title}</Tag>
      {paragraphs.map((paragraph) => (
        <p class="promo_text">{paragraph}</p>
      ))}
      {promo.link && (
        <Button
          element="link"
          variant="link"
          href={promo.link.href}
          aria-label={`${promo.link.label}: ${promo.title}`}
        >
          {promo.link.label}
        </Button>
      )}
    </div>
    {images.length > 0 && (
      <div class:list={["promo_visual", images.length > 1 && "pair"]}>
        {images.map((image) => (
          <SanityImg
            image={image}
            sizes={
              images.length > 1
                ? "(width >= 64rem) 30vw, 100vw"
                : "(width >= 64rem) 45vw, 100vw"
            }
            maxWidth={1600}
          />
        ))}
      </div>
    )}
  </article>
)}

<style is:global>
  @layer components {
    .promo_wrap {
      width: 100%;
      display: grid;
      gap: var(--space-7);
      align-items: center;
      /* On a phone the text and the photographs keep 32px from the edges. */
      padding-inline: 1rem;

      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 31.5rem) minmax(0, 1fr);
        gap: var(--space-8);
        /* The photographs stop 32px short of the page’s edges. */
        padding-inline: 2rem;

        &.reverse {
          grid-template-columns: minmax(0, 1fr) minmax(0, 31.5rem);
          & > .promo_content {
            order: 2;
          }
        }

        &.text-only {
          grid-template-columns: minmax(0, 31.5rem);
          &.reverse {
            justify-content: end;
          }
        }
      }
    }

    .promo_content {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      align-items: start;
    }

    /*
     * The pale putto as the design sets it at 1920: 566px tall in a 644px
     * box that starts 54px left of the text and 324px above it.
     */
    .promo_backdrop {
      display: none;

      @media (width >= 64rem) {
        display: block;
        position: absolute;
        z-index: -1;
        top: -16.875vw;
        left: -1.4583vw;
        width: 30.83vw;
        max-width: none;
        height: auto;
        opacity: 0.075;
        pointer-events: none;
        user-select: none;
      }
    }

    /*
     * 36px between label, title and text at 1920, a quarter more than the
     * design's 29px, as the client asked. A phone draws them tighter under
     * the label and looser under the title.
     */
    .promo_eyebrow {
      margin: 0 0 1.5rem;
      @media (width >= 48rem) {
        margin-bottom: 2.2656rem;
      }
      color: var(--muted-text);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-wide);
    }

    .promo_title {
      margin: 0 0 2rem;
      @media (width >= 48rem) {
        margin-bottom: 2.2656rem;
      }
      text-wrap: balance;
    }

    /* 14px on a phone, 18px from 48rem, as the design sets body copy in a promo. */
    .promo_eyebrow,
    .promo_text {
      @media (width >= 48rem) {
        font-size: var(--text-main);
      }
    }

    .promo_text {
      font-size: var(--text-small);
      margin: 0 0 var(--space-4);
      &:last-of-type {
        margin-bottom: var(--space-5);
      }
    }

    /*
     * Two photographs as the design composes them at 1920 (and at 402 on a
     * phone): a tall one behind and the scene laid over it. Every offset is
     * a share of the back photograph's width, so the pair scales as one.
     * At 1920 the scene overlaps the back one towards the text; on a phone,
     * where the photographs come first, it steps down and to the right.
     */
    .promo_visual {
      position: relative;
      view-timeline: --promo block;

      /* On a phone the photographs come first, the text under them. */
      @media (width < 64rem) {
        order: -1;
      }
      justify-self: end;
      width: 100%;
      max-width: 50.5rem;
      display: grid;
      align-items: start;

      .promo_wrap.reverse & {
        justify-self: start;
      }

      & > .image {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
      }

      &.pair {
        --_back: 69.15vw;
        --_back-ratio: 278 / 415;
        --_front: 107.6%;
        --_front-ratio: 299 / 241;
        --_front-x: 14.03%;
        --_front-y: 30.94%;
        width: var(--_back);
        max-width: none;
        justify-self: start;

        @media (width >= 64rem) {
          .promo_wrap:not(.reverse) & {
            justify-self: end;
          }
        }

        /* Photographs on the right: the one behind starts at the page’s edge. */
        .promo_wrap.reverse & {
          --_back: 68.16vw;
          --_back-ratio: 274 / 321;
          --_front: 100%;
          --_front-ratio: 274 / 329;
          --_front-x: 23.36%;
          --_front-y: 31.75%;
          @media (width < 64rem) {
            margin-left: -1rem;
          }
        }

        /* A tenth smaller than the design draws them, as the client asked. */
        @media (width >= 64rem) {
          --_back: 29.9vw;
          --_back-ratio: 638 / 957;
          --_front: 110.35%;
          --_front-ratio: 704 / 567;
          --_front-x: -26.33%;
          --_front-y: 29%;

          .promo_wrap.reverse & {
            --_back: 25.26vw;
            --_back-ratio: 539 / 713;
            --_front: 128.39%;
            --_front-ratio: 692 / 782;
            --_front-x: 40.26%;
            --_front-y: 38.4%;
          }
        }

        & > .image:first-child {
          aspect-ratio: var(--_back-ratio);
        }

        & > .image:last-child {
          position: relative;
          justify-self: start;
          width: var(--_front);
          max-width: none;
          margin-left: var(--_front-x);
          margin-top: var(--_front-y);
          aspect-ratio: var(--_front-ratio);

          /* The scene in front slides a touch faster than the photograph behind it. */
          @supports (animation-timeline: view()) {
            @media (prefers-reduced-motion: no-preference) {
              animation: promo-drift linear both;
              animation-timeline: --promo;
              animation-range: cover;
            }
          }
        }
      }
    }

    /* The scene that runs off the page is cut at the page's edge, not scrolled to. */
    .section:has(.promo_visual.pair) {
      overflow-x: clip;
    }

    /* Twice as far from 48rem, where the window shows it less. */
    .promo_visual {
      --_drift: 1rem;
      @media (width >= 48rem) {
        --_drift: 2rem;
      }
    }

    @keyframes promo-drift {
      from {
        translate: 0 var(--_drift);
      }
      to {
        translate: 0 calc(var(--_drift) * -1);
      }
    }
  }
</style>
