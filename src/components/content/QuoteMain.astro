---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The quotation, without quotation marks. */
  text?: string;
  /** Who said it. */
  author?: string;
  /** When, already formatted for display. */
  date?: string;
}

const { render = true, text, author, date } = Astro.props;
---

{render && text && (
  <figure class="quote_wrap">
    <blockquote class="quote_text text-style-h2">
      <p>“{text}”</p>
    </blockquote>
    {(author || date) && (
      <figcaption class="quote_caption">
        {author && <span>{date ? `${author}, ` : author}</span>}
        {date && <span class="quote_date">{date}</span>}
      </figcaption>
    )}
  </figure>
)}

<style is:global>
  @layer components {
    .quote_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      /* 57px from the last baseline to the caption on a phone, 67px at 1920. */
      gap: clamp(3.5625rem, 3.397rem + 0.6588vw, 4.1875rem);
      max-width: 76.25rem;
      margin-inline: auto;
      /* On a phone the quotation keeps 32px from the edges. */
      padding-inline: 1rem;
      text-align: center;
    }

    .quote_text {
      margin: 0;
      text-wrap: balance;
      & > p {
        margin: 0;
      }
    }

    /* The design's serif caption, with its old-style figures in the date: 18px on a phone, 20px from 48rem. */
    .quote_caption {
      font-family: var(--secondary-family);
      font-size: 1.125rem;
      @media (width >= 48rem) {
        font-size: 1.25rem;
      }
      font-weight: var(--secondary-medium);
      line-height: 1.1;
      letter-spacing: var(--letter-spacing-snug);
      font-variant-numeric: oldstyle-nums;
    }

    /* The date on a line of its own, as the design breaks it. */
    .quote_date {
      display: block;
    }
  }
</style>
