---
interface Line {
  /** What the line says: who a price is for, when a place is open. */
  text?: string;
  /** A figure set apart on the right: a price. */
  value?: string;
  /** Where the value leads, when it is a link. */
  href?: string;
  /** A word set at the far right in the line's own type: "Video", "Podcast". */
  aside?: string;
}

interface Row {
  label: string;
  /** Where the label leads, when it is a link. */
  href?: string;
  /** Whether the label's link leaves the site. */
  external?: boolean;
  lines: Line[];
}

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Labelled rows, each with one line or several. */
  rows: Row[];
  /** Class names for utilities. */
  class?: string;
}

const { render = true, rows, class: className } = Astro.props;

const shown = rows.filter((row) => row.label && row.lines.length > 0);
---

{render && shown.length > 0 && (
  <dl class:list={["info-list_wrap", className]}>
    {shown.map((row) => (
      <div class="info-list_row">
        <dt class="info-list_label text-style-large">
          {row.href ? (
            <a
              class="info-list_link link-underline"
              href={row.href}
              rel={row.external ? "noopener" : undefined}
            >
              {row.label}
            </a>
          ) : (
            row.label
          )}
        </dt>
        {row.lines.map((line) => (
          <dd class="info-list_line">
            <span class="info-list_text">{line.text}</span>
            {line.aside && <span class="info-list_aside">{line.aside}</span>}
            {line.value &&
              (line.href ? (
                <a
                  class="info-list_value info-list_link link-underline text-style-large"
                  href={line.href}
                >
                  {line.value}
                </a>
              ) : (
                <span class="info-list_value text-style-large">
                  {line.value}
                </span>
              ))}
          </dd>
        ))}
      </div>
    ))}
  </dl>
)}

<style is:global>
  @layer components {
    /*
     * As the design draws its price and opening-hours tables: rules across
     * the column, the label in bold, and from the line above each cap to the
     * rule under each baseline 23px and 22px on a phone, 30px and 29px at
     * 1920. On a phone the words sit 1rem in from the ends of the rules.
     */
    .info-list_wrap {
      --_pad-top: clamp(1.4563rem, 1.3487rem + 0.4282vw, 1.8625rem);
      --_pad-bottom: clamp(1.4rem, 1.2941rem + 0.4216vw, 1.8rem);
      --_inset: 1rem;
      width: 100%;
      margin-block: var(--space-3) 0;
      border-bottom: var(--border-width) solid var(--text);
      @media (width >= 48rem) {
        --_inset: 0rem;
      }
    }

    .info-list_row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      column-gap: var(--site-gutter);
      padding-inline: var(--_inset);
      border-top: var(--border-width) solid var(--text);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* The label sits level with its first line; further lines follow under a dashed rule. */
    .info-list_label {
      padding-top: var(--_pad-top);
      padding-bottom: 1.2312rem;
      font-weight: var(--primary-bold);
      line-height: clamp(1.45rem, 1.3209rem + 0.5138vw, 1.9375rem);
      @media (width >= 48rem) {
        grid-column: 1;
        grid-row: 1;
        align-self: center;
        max-width: 18.55em;
        padding-block: var(--_pad-top) var(--_pad-bottom);
      }
    }

    .info-list_line {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin: 0;
      padding-block: var(--_pad-top) var(--_pad-bottom);
      @media (width >= 48rem) {
        grid-column: 2;
      }

      .info-list_label + & {
        @media (width < 48rem) {
          padding-top: 0;
        }
      }

      & + &::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline: calc(-1 * var(--_inset));
        border-top: var(--border-width) dashed var(--text);
        opacity: 0.3;
        @media (width >= 48rem) {
          inset-inline: auto 0;
          width: calc(200% + var(--site-gutter));
        }
      }
    }

    /* Beside a price, the words wrap where the design wraps them. */
    .info-list_text {
      text-box: trim-both cap alphabetic;

      .info-list_line:has(.info-list_value) & {
        max-width: 14em;
        @media (width >= 48rem) {
          max-width: 21.5em;
        }
      }
    }

    .info-list_aside {
      flex: none;
      margin-inline-start: auto;
      text-align: end;
    }

    /* A price: plain on a phone, bold beside the wider table. */
    .info-list_value {
      flex: none;
      white-space: nowrap;
      @media (width >= 48rem) {
        font-weight: var(--primary-bold);
      }
    }

    /* The shared underline draws in on hover, as the words turn red. */
    .info-list_link {
      color: inherit;
      @media (hover: hover) {
        &:hover {
          color: var(--link-text);
        }
      }
    }
  }
</style>
