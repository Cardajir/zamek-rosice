---
import { DEFAULT_LANG, LANG_LOCALES } from "@/consts.ts";
import { ui } from "@/i18n/ui.ts";
import type { Shell } from "@/sanity/queries.ts";
import { slotContent } from "@/utils/slots.ts";
import { openStatusText } from "@/utils/status.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Address, admission and opening hours. */
  shell: Pick<
    Shell,
    "street" | "postalCode" | "locality" | "prices" | "opening" | "closures"
  >;
  /** Text shown on the left in place of admission. */
  note?: string;
  /** Class names for utilities. */
  class?: string;
}

const { render = true, shell, note, class: className } = Astro.props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const status = openStatusText(shell.opening, lang, new Date(), shell.closures);
const price = new Intl.NumberFormat(LANG_LOCALES[lang], {
  style: "currency",
  currency: "CZK",
  maximumFractionDigits: 0,
});
const prices = shell.prices.slice(0, 2).map((value) => price.format(value));
const center = await slotContent(Astro.slots, "center");

/*
 * A note with a comma reads as a name and what it is, set as the design sets
 * the organisation: the name in semibold, the rest under it in regular.
 */
const comma = note?.indexOf(", ") ?? -1;
const noteLines =
  note && comma > 0 ? [note.slice(0, comma + 1), note.slice(comma + 2)] : undefined;
---

{render && (
  <div class:list={["status-bar_wrap", className]}>
    <p class="status-bar_item">
      {noteLines ? (
        <Fragment>
          <span>{noteLines[0]}</span>
          <span class="status-bar_detail">{noteLines[1]}</span>
        </Fragment>
      ) : note ? (
        <span class="status-bar_note">{note}</span>
      ) : (
        prices.length > 0 && (
          <Fragment>
            <span>{t.admissionLabel}</span>
            <span class="status-bar_detail">{prices.join(" / ")}</span>
          </Fragment>
        )
      )}
    </p>
    <div class:list={["status-bar_center", !center && "is-address"]}>
      {center ? (
        <Fragment set:html={center} />
      ) : (
        <p class="status-bar_address text-style-large">
          <span>{shell.street},</span>
          <span>
            {shell.postalCode} {shell.locality}
          </span>
        </p>
      )}
    </div>
    <p class="status-bar_item status-bar_status">
      <span class:list={["status-bar_state", status.isOpen && "open"]}>
        {status.label}
      </span>
      {status.detail && <span>{status.detail}</span>}
    </p>
  </div>
)}

<style is:global>
  @layer components {
    .status-bar_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: auto auto;
      justify-content: space-between;
      gap: var(--space-4) var(--space-6);
      /* 17px from the rule to the text on a phone, as the design sets it. */
      padding-top: 0.9375rem;

      @media (width >= 48rem) {
        padding-top: var(--space-4);
      }
      border-top: var(--border-width) solid var(--text);
      /* 18px at 1920, 12px on a phone. */
      font-size: clamp(0.75rem, 0.6506rem + 0.3953vw, 1.125rem);
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      letter-spacing: var(--letter-spacing-snug);

      @media (width >= 48rem) {
        grid-template-columns: 1fr auto 1fr;
        justify-content: normal;
      }
    }

    .status-bar_item {
      display: flex;
      flex-direction: column;
      margin: 0;
    }

    .status-bar_center {
      grid-column: 1 / -1;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;

      @media (width >= 48rem) {
        grid-column: 2;
        grid-row: 1;
      }

      /* On a phone whatever stands in the middle drops 110px below the bar. */
      &:not(.is-address) {
        @media (width < 48rem) {
          margin-top: 5.625rem;
        }
      }

      /* A phone shows no address here; the footer and contact page carry it. */
      &.is-address {
        @media (width < 48rem) {
          display: none;
        }
      }
    }

    /* The second line on the left: regular, its first letter a capital. */
    .status-bar_detail {
      font-weight: var(--primary-regular);
      &::first-letter {
        text-transform: uppercase;
      }
    }

    /* Two lines, broken after “památka” as the design breaks it. */
    .status-bar_note {
      max-width: 12.5em;
    }

    .status-bar_address {
      display: flex;
      flex-direction: column;
      margin: 0;
      font-variant-numeric: oldstyle-nums;
      font-family: var(--secondary-family);
      font-weight: var(--secondary-medium);
      line-height: var(--line-height-medium);
      letter-spacing: var(--letter-spacing-snug);
    }

    .status-bar_status {
      align-items: end;
      text-align: end;
    }

    .status-bar_state {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      &::before {
        content: "";
        width: 0.7em;
        height: 0.7em;
        border-radius: var(--radius-round);
        background-color: var(--status-closed);
      }
      &.open::before {
        background-color: var(--status-open);
      }
    }
  }
</style>
