---
import Parallax from "@/components/media/Parallax.astro";
import Img from "@/components/media/Img.astro";
import SanityImg from "@/components/media/SanityImg.astro";
import admission from "@/assets/heroes/admission.jpg";
import contact from "@/assets/heroes/contact.jpg";
import directions from "@/assets/heroes/directions.jpg";
import gallery from "@/assets/heroes/gallery.jpg";
import history from "@/assets/heroes/history.jpg";
import news from "@/assets/heroes/news.jpg";
import tours from "@/assets/heroes/tours.jpg";
import { matchRoute, stripLang, type RouteId } from "@/i18n/routes.ts";
import { shellFor, type Image } from "@/sanity/queries.ts";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The page's title, set over the photograph as its only heading 1. */
  title: string;
  /**
   * The photograph. By default the one the design gives the page, and the
   * home page's hero on a page the design does not draw.
   */
  image?: Image;
  /** The rule under the photograph. Off where a status bar draws its own. */
  rule?: boolean;
  /** Class names for utilities. */
  class?: string;
}

const { render = true, title, rule = true, class: className } = Astro.props;

interface Photo {
  src: ImageMetadata;
  /** Where the crop sits when the frame cuts the photograph. */
  position?: string;
}

/*
 * The photograph each subpage has in the design, picked by the address so
 * the pages need not pass it. A code route matches in every language and
 * with a detail slug after it; a page-builder page by its Czech address.
 */
const ROUTE_PHOTOS: Partial<Record<RouteId, Photo>> = {
  news: { src: news },
  tours: { src: tours },
  admission: { src: admission },
  directions: { src: directions },
  gallery: { src: gallery },
  galleryEvents: { src: gallery },
  /* The design shows the arcade's balustrade, a little above the middle. */
  contact: { src: contact, position: "50% 33%" },
};
const PAGE_PHOTOS: Record<string, Photo> = {
  "/o-zamku/z-historie": { src: history },
  "/navstivte-nas/navstevni-rad": { src: tours },
};

const pathname = Astro.locals.pathname ?? Astro.url.pathname;
const routeId = matchRoute(pathname)?.id;
const bare = stripLang(pathname);
const photo = Astro.props.image
  ? undefined
  : ((routeId && ROUTE_PHOTOS[routeId]) ?? PAGE_PHOTOS[bare]);
const image =
  Astro.props.image ??
  (photo ? undefined : (await shellFor(Astro.locals)).pageHero);
/* A link set in the photograph’s top-left corner, such as the way back up. */
const corner = await slotContent(Astro.slots, "corner");
---

{render && title && (
  <div class:list={["page-hero_wrap", rule && "has-rule", className]}>
    <div
      class:list={[
        "page-hero_visual",
        (photo || image) && "theme-dark has-image",
      ]}
    >
      {photo && (
        <Parallax>
          <Img
            src={photo.src}
            loading="eager"
            fetchPriority="high"
            style={photo.position && `object-position: ${photo.position}`}
          />
        </Parallax>
      )}
      {image && (
        <Parallax>
          <SanityImg
            image={{ ...image, alt: "" }}
            ratio={1645 / 705}
            narrowRatio={1}
            loading="eager"
            fetchPriority="high"
          />
        </Parallax>
      )}
      {corner && (
        <div class="page-hero_corner">
          <Fragment set:html={corner} />
        </div>
      )}
      <h1 class="page-hero_title text-style-h1" data-reveal-letters>
        {title}
      </h1>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    /*
     * The top of every subpage as the design draws it at 1920: the castle's
     * photograph (1645 × 705) under a dark veil, the page's title centred on
     * it, and a rule 13px below.
     */
    .page-hero_wrap {
      width: 100%;
      /* 13px at 1920, 8px on a phone. */
      padding-bottom: clamp(0.5rem, 0.4172rem + 0.3294vw, 0.8125rem);

      &.has-rule {
        border-bottom: var(--border-width) solid var(--text);
      }
    }

    .page-hero_visual {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 12rem;
      padding: var(--space-6);

      /* 1645 × 705 at 1920; square on a phone. */
      &.has-image {
        aspect-ratio: 1645 / 705;
        min-height: 16rem;
        @media (width < 48rem) {
          aspect-ratio: 1;
        }
        padding: 0;
        overflow: clip;
        background-color: var(--background);
        color: var(--text);

        & > .parallax_wrap {
          position: absolute;
          inset: 0;
          height: 100%;

          & > .image,
          & > picture > .image {
            height: 100%;
            object-fit: cover;
          }
        }

        &::after {
          content: "";
          position: absolute;
          inset: 0;
          background-color: color-mix(in lab, black 30%, transparent);
        }
      }
    }

    /* 33px in and 36px down at 1920. */
    .page-hero_corner {
      position: absolute;
      z-index: 1;
      top: clamp(1rem, 0.6696rem + 1.3175vw, 2.25rem);
      left: clamp(1rem, 0.7397rem + 1.0382vw, 2.0625rem);
    }

    /* The title in a 968px box, wide enough for a tour’s name on one line. */
    .page-hero_title {
      position: relative;
      z-index: 1;
      max-width: calc(60.5rem + var(--space-5) * 2);
      margin: 0;
      padding-inline: var(--space-5);
      text-align: center;
      text-wrap: balance;
    }
  }
</style>
