---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import PortableImage from "@/components/utility/PortableImage.astro";
import StatusBarMain from "@/components/content/StatusBarMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getDirections } from "@/sanity/page-queries.ts";
import { shellFor } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const [shell, directions] = await Promise.all([
  shellFor(Astro.locals),
  getDirections(lang),
]);

/* An editor's own map link wins; otherwise the castle's coordinates on Mapy.com. */
const { location } = directions;
const mapUrl =
  directions.mapUrl ??
  (location &&
    `https://mapy.com/fnc/v1/showmap?mapset=basic&center=${location.lng},${location.lat}&zoom=17&marker=true`);

const ways = [
  { heading: t.byCar, text: directions.byCar },
  { heading: t.byTrain, text: directions.byTrain },
  { heading: t.byBus, text: directions.byBus },
  { heading: t.parking, text: directions.parking },
  { heading: t.accessibility, text: directions.accessibility },
].filter((way) => way.text);

const address = `${shell.street}, ${shell.postalCode} ${shell.locality}`;
---

<Layout
  title={t.directionsTitle}
  description={directions.intro}
  alternates={alternates("directions")}
>
  <!-- Status bar -->
  <Section paddingTop="none" paddingBottom="small">
    <StatusBarMain shell={shell} />
  </Section>

  <!-- Title -->
  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper centered>
      <Heading tag="h1" maxWidth={12}>
        {t.directionsTitle}
      </Heading>
    </ContentWrapper>
  </Section>

  <!-- Address and map -->
  <Section
    containerClass="max-width-small"
    paddingTop="small"
    paddingBottom="small"
  >
    <Ornament slot="background" variant={7} size="large" />
    <ContentWrapper>
      <Paragraph variant="large">{address}</Paragraph>
      <Paragraph maxWidth={80}>{directions.intro}</Paragraph>
      <ButtonWrapper>
        <Button
          render={Boolean(mapUrl)}
          element="link"
          variant="link"
          href={mapUrl}
          rel="noopener"
        >
          {t.showOnMap}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Ways of getting here -->
  <Section
    containerClass="max-width-small"
    render={ways.length > 0}
    paddingTop="small"
    gap="6"
  >
    <Heading tag="h2" variant="h3">
      {t.howToGetHere}
    </Heading>
    {ways.map((way) => (
      <ContentWrapper>
        <Heading tag="h3" variant="h6">
          {way.heading}
        </Heading>
        <Paragraph maxWidth={80}>{way.text}</Paragraph>
      </ContentWrapper>
    ))}
  </Section>

  <!-- Photograph -->
  <Section
    containerClass="max-width-small"
    render={Boolean(directions.image)}
    paddingTop="small"
  >
    <PortableImage node={directions.image ?? {}} />
  </Section>
</Layout>
