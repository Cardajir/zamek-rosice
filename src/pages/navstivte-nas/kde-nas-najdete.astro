---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import PortableImage from "@/components/utility/PortableImage.astro";
import Img from "@/components/media/Img.astro";
import castle from "@/assets/photos/castle-southwest.jpg";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getDirections } from "@/sanity/page-queries.ts";
import { formatPlain } from "@/utils/text-blocks.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const directions = await getDirections(lang);

/* An editor's own map link wins; otherwise the castle's coordinates on Mapy.com. */
const { location } = directions;
const mapUrl =
  directions.mapUrl ??
  (location &&
    `https://mapy.com/fnc/v1/showmap?mapset=basic&center=${location.lng},${location.lat}&zoom=17&marker=true`);

/* The Studio's plain text: its paragraphs, line breaks and bold words. */
const escape = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
const paragraphs = (value?: string) =>
  formatPlain(value).map((lines) =>
    lines
      .map((runs) =>
        runs
          .map(({ text, bold }) =>
            bold ? `<strong>${escape(text)}</strong>` : escape(text),
          )
          .join(""),
      )
      .join("<br />"),
  );

const ways = [
  { heading: t.byCar, text: directions.byCar },
  { heading: t.byTrain, text: directions.byTrain },
  { heading: t.byBus, text: directions.byBus },
  { heading: t.parking, text: directions.parking },
  { heading: t.accessibility, text: directions.accessibility },
]
  .map((way) => ({ heading: way.heading, paragraphs: paragraphs(way.text) }))
  .filter((way) => way.paragraphs.length > 0);
---

<Layout
  title={t.directionsTitle}
  description={directions.intro?.replace(/\*\*/g, "")}
  alternates={alternates("directions")}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.directionsTitle} />
  </Section>

  <!-- Where the castle is, and the map -->
  <Section
    containerClass="max-width-small"
    paddingTop="none"
    paddingBottom="none"
    class="directions_place"
    data-stacki-key="km7pivlca3c1g"
  >
    <div slot="background" class="directions_backdrop">
      <Ornament variant={7} size="large" />
    </div>
    <ContentWrapper>
      <Heading tag="h2" variant="h3">
        {t.directionsTitle}
      </Heading>
      {paragraphs(directions.intro).map((html) => (
        <Paragraph variant="large">
          <Fragment set:html={html} />
        </Paragraph>
      ))}
      <ButtonWrapper>
        <Button
          render={Boolean(mapUrl)}
          element="link"
          variant="link"
          href={mapUrl}
          rel="noopener"
        >
          {t.showOnMap}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Ways of getting here -->
  <Section
    containerClass="max-width-small"
    render={ways.length > 0}
    paddingTop="none"
    paddingBottom="none"
    class="directions_ways"
    data-stacki-key="k9h0if2g58ofd"
  >
    <Heading tag="h2" variant="h3">
      {t.howToGetHere}
    </Heading>
    {ways.map((way) => (
      <ContentWrapper data-stacki-key="ky9gh7slgsxkn">
        <Heading tag="h3" variant="h6">
          {way.heading}
        </Heading>
        {way.paragraphs.map((html) => (
          <Paragraph variant="large">
            <Fragment set:html={html} />
          </Paragraph>
        ))}
      </ContentWrapper>
    ))}
  </Section>

  <!-- Photograph: an editor's own, or the castle from the south-west as the design has it -->
  <Section
    containerClass="max-width-small"
    paddingTop="none"
    paddingBottom="none"
    class="directions_photo"
  >
    {directions.image ? (
      <PortableImage node={directions.image} />
    ) : (
      <figure class="directions_figure">
        <Img src={castle} alt={t.directionsPhotoAlt} />
        <figcaption class="directions_caption">
          {t.directionsPhotoCaption}
        </figcaption>
      </figure>
    )}
  </Section>
</Layout>

<style is:global>
  /*
   * As the design spaces it at 1920, from line to line: 267px from the rule
   * under the photograph to the first heading; 86px under a big heading,
   * 55px under a small one; 38px between paragraphs, 73px between ways;
   * 33px from the text to the map link, 76px and 78px either side of the
   * rule (the link box reaches below its words); 78px down to the photograph
   * and 196px under its caption. A phone keeps the text 1rem in from the
   * rule, with the spacing of the design's other phone pages.
   */
  .directions_place,
  .directions_ways,
  .directions_photo {
    --_after-title: clamp(3.375rem, 2.8702rem + 2.0092vw, 5.2813rem);
    --_after-heading: clamp(1.9187rem, 1.5215rem + 1.581vw, 3.4188rem);
    --_paragraph: clamp(1.2312rem, 0.935rem + 1.1792vw, 2.35rem);
    --_way: clamp(2.5rem, 1.9588rem + 2.1542vw, 4.5438rem);

    & > .container {
      row-gap: 0;
      @media (width < 48rem) {
        padding-inline: 1rem;
      }
    }
    & .layout > * > * {
      margin-block: 0;
    }
    & .text-style-large {
      line-height: clamp(1.45rem, 1.3209rem + 0.5138vw, 1.9375rem);
    }
    & .text + .text {
      margin-top: var(--_paragraph);
    }
    & .heading.text-style-h3 + * {
      margin-top: var(--_after-title);
    }
    & .heading.text-style-h6 + * {
      margin-top: var(--_after-heading);
    }
  }

  /*
   * The engraving under the photograph keeps the design's distance from the
   * rule: 19px on a phone, 120px at 1920.
   */
  .directions_backdrop {
    padding-top: clamp(1.1875rem, -0.4844rem + 6.653vw, 7.5rem);
  }

  .directions_place {
    padding-top: clamp(3.5625rem, 0.0867rem + 13.834vw, 16.6875rem);
    padding-bottom: clamp(2.8312rem, 2.434rem + 1.581vw, 4.3312rem);

    & .button-wrapper {
      margin-top: clamp(0.525rem, 0.3793rem + 0.5797vw, 1.075rem);
    }
  }

  .directions_ways > .container {
    padding-block: clamp(4.1rem, 3.8997rem + 0.7971vw, 4.8563rem)
      clamp(2.5rem, 1.8744rem + 2.4901vw, 4.8625rem);
    border-top: var(--border-width) solid var(--text);

    & > .layout + .layout {
      margin-top: var(--_way);
    }
  }

  .directions_photo {
    @media (width < 48rem) {
      & > .container {
        padding-inline: 0;
      }
    }
  }

  /* 1312 × 633 at 1920, the caption set right under it in two lines. */
  .directions_figure {
    width: 100%;
    margin: 0;

    & > .image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1312 / 633;
      object-fit: cover;
    }
  }

  .directions_caption {
    margin-top: clamp(1rem, 0.8047rem + 0.7773vw, 1.7375rem);
    font-size: clamp(0.75rem, 0.6507rem + 0.3953vw, 1.125rem);
    font-weight: var(--primary-semibold);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-snug);
    text-align: end;
    white-space: pre-line;
    text-box: trim-both cap alphabetic;
    @media (width < 48rem) {
      padding-inline: 1rem;
    }
  }

  .directions_ways:last-child > .container,
  .directions_photo {
    padding-bottom: clamp(5.0625rem, 3.1641rem + 7.556vw, 12.2312rem);
  }
</style>
