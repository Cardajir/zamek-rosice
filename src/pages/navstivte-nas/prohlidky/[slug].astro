---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Button from "@/components/Button.astro";
import TourDetailMain from "@/components/content/TourDetailMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { anchor } from "@/utils/slug.ts";
import { getTour } from "@/sanity/queries.ts";
import { sanitySocialImage } from "@/utils/seo.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const tour = await getTour(lang, Astro.params.slug ?? "");

if (!tour) return Astro.rewrite("/404/");

const { min, max, unlimited } = tour.duration ?? {};
const span = min && max && min !== max ? `${min}–${max}` : (max ?? min);
const eyebrow = tour.free
  ? t.admissionFree
  : unlimited
    ? `${t.tourLength}: ${t.tourLengthUnlimited}`
    : span
      ? `${t.tourLength}: ${span} ${t.minutesLong}`
      : undefined;

/* Admission unless entry is free, and the tour's album (the gallery until one is linked). */
const links = [
  ...(tour.free
    ? []
    : [
        {
          label: t.admissionLink,
          href: `${routePath("admission", lang)}${tour.priceList ? `#${anchor(tour.priceList)}` : ""}`,
        },
      ]),
  { label: t.galleryLink, href: routePath("gallery", lang, tour.gallery) },
];

/* The first photograph heads the page; the rest follow the text. */
const [hero, ...photos] = tour.images;
---

<Layout
  title={tour.title}
  description={tour.perex}
  image={sanitySocialImage(tour.image)}
  alternates={alternates("tours", tour.slugs)}
  breadcrumbs={[{ name: t.toursPageTitle, path: routePath("tours", lang) }]}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={tour.title} image={hero}>
      <span slot="corner" class="tour_hero-back">
        <Button
          element="link"
          variant="link"
          direction="back"
          href={routePath("tours", lang)}
        >
          {t.backToTours}
        </Button>
      </span>
    </PageHeroMain>
  </Section>

  <!-- Length, links, text and photographs -->
  <Section
    paddingTop="none"
    paddingBottom="none"
    containerClass="max-width-small"
  >
    <TourDetailMain
      eyebrow={eyebrow}
      links={links}
      title={tour.title}
      body={tour.body}
      images={photos}
    />
  </Section>
</Layout>

<style is:global>
  /* The phone design leaves the photograph clear: the way back is under the text. */
  .tour_hero-back {
    @media (width < 48rem) {
      display: none;
    }
  }
</style>
