---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import TourListMain from "@/components/content/TourListMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { anchor } from "@/utils/slug.ts";
import { getTours, type TourCard } from "@/sanity/queries.ts";
import { fillIn, listOf } from "@/utils/seo.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const tours = await getTours(lang);

const eyebrow = ({ duration, free }: TourCard) => {
  if (free) return t.admissionFree;
  if (duration?.unlimited) return `${t.tourLength}: ${t.tourLengthUnlimited}`;
  const { min, max } = duration ?? {};
  if (!min && !max) return undefined;
  const span = min && max && min !== max ? `${min}–${max}` : (max ?? min);
  return `${t.tourLength}: ${span} ${t.minutesLong}`;
};

/* The tour's page, its admission unless entry is free, and its album (the gallery until one is linked). */
const links = (tour: TourCard) => [
  { label: t.readMore, href: routePath("tours", lang, tour.slug) },
  ...(tour.free
    ? []
    : [
        {
          label: t.admissionLink,
          href: `${routePath("admission", lang)}${tour.priceList ? `#${anchor(tour.priceList)}` : ""}`,
        },
      ]),
  { label: t.galleryLink, href: routePath("gallery", lang, tour.gallery) },
];

const title = t.toursPageTitle;
---

<Layout
  title={title}
  description={fillIn(t.metaTours, {
    list: listOf(tours.map((tour) => tour.title)),
  })}
  pageType="CollectionPage"
  alternates={alternates("tours")}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={title} />
  </Section>

  <!-- Tours -->
  <Section
    render={tours.length > 0}
    paddingTop="none"
    paddingBottom="none"
    containerClass="max-width-small"
    data-stacki-key="kz2p43789y75t"
  >
    <TourListMain
      tours={tours.map((tour) => ({
        eyebrow: eyebrow(tour),
        title: tour.title,
        text: tour.perex,
        image: tour.image,
        links: links(tour),
      }))}
    />
  </Section>
</Layout>
