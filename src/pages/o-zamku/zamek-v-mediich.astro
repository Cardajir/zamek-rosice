---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import InfoListMain from "@/components/content/InfoListMain.astro";
import { DEFAULT_LANG, LANG_LOCALES } from "@/consts.ts";
import { alternates } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getMedia, type MediaMention } from "@/sanity/page-queries.ts";
import { fillIn, listOf } from "@/utils/seo.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const mentions = await getMedia();

const kinds: Record<NonNullable<MediaMention["kind"]>, string> = {
  video: t.mediaVideo,
  article: t.mediaArticle,
  podcast: t.mediaPodcast,
  tv: t.mediaTv,
};
const fullDate = new Intl.DateTimeFormat(LANG_LOCALES[lang], {
  day: "numeric",
  month: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

/* What kind of piece it is, who published it and when; the address stands in when nothing is known. */
/* Where and when on the left; the kind (video, podcast, article) at the far right. */
const about = ({ outlet, date, url }: MediaMention) =>
  [outlet, date && fullDate.format(new Date(`${date}T00:00:00Z`))]
    .filter(Boolean)
    .join(" · ") || new URL(url).hostname.replace(/^www\./, "");
---

<Layout
  title={t.mediaTitle}
  description={fillIn(t.metaMedia, {
    list: listOf(
      mentions.map(
        ({ outlet, url }) =>
          outlet ?? new URL(url).hostname.replace(/^www\./, ""),
      ),
    ),
  })}
  alternates={alternates("media")}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.mediaTitle} />
  </Section>

  <!-- Mentions -->
  <Section
    containerClass="max-width-small"
    render={mentions.length > 0}
    paddingTop="small"
  >
    <InfoListMain
      rows={mentions.map((mention) => ({
        label: mention.title,
        href: mention.url,
        external: true,
        lines: [
          {
            text: about(mention),
            aside: mention.kind ? kinds[mention.kind] : undefined,
          },
        ],
      }))}
      data-stacki-key="ko1rv6dl6h4ix"
    />
  </Section>
</Layout>
