---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import NewsArticleMain from "@/components/content/NewsArticleMain.astro";
import {
  DEFAULT_LANG,
  LANGS,
  LANG_LOCALES,
  SITE_TIME_ZONE,
  type Lang,
} from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getPost, shellFor } from "@/sanity/queries.ts";
import {
  DEFAULT_SOCIAL_IMAGE,
  articleNode,
  blocksToText,
  businessOf,
  describe,
  eventNode,
  sanitySocialImage,
} from "@/utils/seo.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const post = await getPost(lang, Astro.params.slug ?? "");

if (!post) return Astro.rewrite("/404/");

const isLang = (value: string): value is Lang =>
  (LANGS as readonly string[]).includes(value);
const slugs = Object.fromEntries(
  post.translations
    .filter((item) => isLang(item.lang))
    .map((item) => [item.lang, item.slug]),
);
const versions = alternates("news", { ...slugs, [lang]: post.slug });

const date = new Intl.DateTimeFormat(LANG_LOCALES[lang], {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: SITE_TIME_ZONE,
});
const isEvent = post.kind === "event";

/* What search and sharing show: the poster, the perex, and the item as an event or an article. */
const socialImage = sanitySocialImage(post.image);
const description = describe(post.perex) ?? describe(blocksToText(post.body));
const url = new URL(Astro.locals.pathname ?? Astro.url.pathname, Astro.site)
  .href;
const shell = await shellFor(Astro.locals);
const schema =
  isEvent && post.eventStart
    ? eventNode({
        url,
        name: post.title,
        description,
        image: socialImage,
        start: post.eventStart,
        end: post.eventEnd,
        status: post.eventStatus,
        place: post.eventPlace ?? t.siteName,
        ticketUrl: post.eventTicketUrl,
        price: post.eventPrice,
        language: LANG_LOCALES[lang],
        business: businessOf(shell),
      })
    : articleNode({
        url,
        headline: post.title,
        description,
        /* An article needs a picture; the castle's front stands in for a missing one. */
        image: socialImage ?? {
          ...DEFAULT_SOCIAL_IMAGE,
          src: new URL(DEFAULT_SOCIAL_IMAGE.src, Astro.site).href,
        },
        datePublished: post.publishedAt,
        dateModified: post.updatedAt,
        language: LANG_LOCALES[lang],
      });
const when = [
  post.eventStart && date.format(new Date(post.eventStart)),
  post.eventEnd && date.format(new Date(post.eventEnd)),
]
  .filter(Boolean)
  .join(" – ");
const facts = isEvent
  ? [
      [t.eventWhen, [when, post.eventTimeNote].filter(Boolean).join(", ")],
      [t.eventWhere, post.eventPlace],
      [t.eventAdmission, post.eventPrice],
    ].filter((fact): fact is [string, string] => Boolean(fact[1]))
  : [];
---

<Layout
  title={post.title}
  description={description}
  type="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt}
  image={socialImage}
  alternates={versions}
  breadcrumbs={[{ name: t.news, path: routePath("news", lang) }]}
  schema={[schema]}
>
  <!-- Poster, title and text -->
  <Section paddingTop="none" class="padding-bottom-6">
    <NewsArticleMain
      heading={post.title}
      eyebrow={post.eventStatus === "cancelled" ? t.eventCancelled : undefined}
      image={post.image}
      body={post.body}
      text={post.perex}
      facts={facts}
      ticketHref={post.eventTicketUrl}
      ticketLabel={t.eventTickets}
      backHref={routePath("news", lang)}
      backLabel={t.backToNews}
    />
  </Section>
</Layout>
