---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import EventsMain from "@/components/content/EventsMain.astro";
import { DEFAULT_LANG, SITE_TIME_ZONE } from "@/consts.ts";
import { alternates } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getNews } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const news = await getNews(lang);

const featured = news.featured ? [news.featured] : [];
const pinned = new Set(featured.map((post) => post.slug));
const upcoming = news.upcoming.filter((post) => !pinned.has(post.slug));
const archive = news.archive.filter((post) => !pinned.has(post.slug));
/* The pinned item's heading names this year's season, as the design does. */
const season = new Intl.DateTimeFormat("en", {
  year: "numeric",
  timeZone: SITE_TIME_ZONE,
}).format(new Date());

const empty = featured.length + upcoming.length + archive.length === 0;

/* Six items to a page, as the design lists them, then "show more". */
const PAGE_SIZE = 6;
/* The archive opens with three, as the client asked. */
const ARCHIVE_PAGE_SIZE = 3;
---

<Layout title={t.news} alternates={alternates("news")}>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.news} />
  </Section>

  <!-- Pinned item -->
  <Section
    render={featured.length > 0}
    paddingTop="large"
    paddingBottom="small"
    data-stacki-key="kizj46mp8m2vz"
  >
    <div slot="background" class="news_backdrop">
      <Ornament variant={3} size="large" />
    </div>
    <EventsMain
      posts={featured}
      heading={`${t.lastMinute} ${season}!`}
      headingTag="h3"
      variant="featured"
    />
  </Section>

  <!-- Upcoming events -->
  <Section
    render={upcoming.length > 0}
    paddingBottom="large"
    data-stacki-key="k7d195t3t3ixh"
  >
    <EventsMain
      posts={upcoming}
      heading={t.upcomingEvents}
      pageSize={PAGE_SIZE}
    />
  </Section>

  <!-- Archive -->
  <Section
    render={archive.length > 0}
    paddingTop="none"
    paddingBottom="large"
    data-stacki-key="k8t0oh5xthw6x"
  >
    <EventsMain
      posts={archive}
      heading={t.pastEvents}
      pageSize={ARCHIVE_PAGE_SIZE}
      shaded
    />
  </Section>

  <!-- Nothing in this language yet -->
  <Section render={empty}>
    <ContentWrapper centered>
      <p>{t.notTranslated}</p>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  /*
   * The engraving under the photograph keeps the design's distance from the
   * rule, 120px at 1920. The phone design has none over the pinned item.
   */
  .news_backdrop {
    padding-top: clamp(1.1875rem, -0.4844rem + 6.653vw, 7.5rem);
    @media (width < 48rem) {
      display: none;
    }
  }
</style>
