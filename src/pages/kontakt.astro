---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Img from "@/components/media/Img.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Choice from "@/components/form/Choice.astro";
import ContactLinesMain from "@/components/content/ContactLinesMain.astro";
import StatusBarMain from "@/components/content/StatusBarMain.astro";
import arcade from "@/assets/photos/arcade-balustrade.jpg";
import hornsOfPlenty from "@/assets/ornaments/ornament-3.svg";
import { DEFAULT_LANG, formatPhone } from "@/consts.ts";
import { alternates } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getPeople } from "@/sanity/page-queries.ts";
import { shellFor } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const [shell, people] = await Promise.all([
  shellFor(Astro.locals),
  getPeople(lang),
]);

const tel = (value: string) => `tel:${value.replace(/[^\d+]/g, "")}`;

/* Public by design: the widget needs it in the page. Empty means no challenge. */
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
  string | undefined;
---

<Layout
  title={t.contactTitle}
  alternates={alternates("contact")}
  footerCta={false}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.contactTitle} rule={false} />
  </Section>

  <!-- Status bar -->
  <Section paddingTop="none" paddingBottom="small" data-stacki-key="kz7cqta7kuy00">
    <StatusBarMain shell={shell} note={shell.organisation} />
  </Section>


  <!-- Contacts and form -->
  <Section paddingTop="small">
    <ContentWrapper variant="columns" column1Class="align-self-start">
      <ContactLinesMain shell={shell} size="large" />
      {people.length > 0 && (
        <div class="contact_people">
          <h2 class="contact_people_title">{t.contactPeople}</h2>
          <ul class="contact_people_list">
            {people.map((person) => (
              <li>
                {[person.name, person.role].filter(Boolean).join(", ")}
                {person.phone && (
                  <Fragment>
                    {", "}
                    <a href={tel(person.phone)}>{formatPhone(person.phone)}</a>
                  </Fragment>
                )}
                {person.email && (
                  <Fragment>
                    {", "}
                    <a href={`mailto:${person.email}`}>{person.email}</a>
                  </Fragment>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div slot="column2" class="contact_form_wrap">
        <Heading tag="h2" variant="h5">
          {t.contactForm}
        </Heading>
        <Form
          name="contact"
          action="/api/contact"
          successMessage={t.formSent}
          errorMessage={t.formFailed}
          variant="lined"
          class="margin-top-7"
          data-stacki-key="kkakiy7iycqos"
        >
          <Input
            variant="first-name"
            label={t.formName}
            name="name"
            maxlength={100}
            required
            labelHidden
            data-stacki-key="khx919k18xg6t"
          />
          <Input
            variant="last-name"
            label={t.formSurname}
            name="surname"
            maxlength={100}
            labelHidden
          />
          <Input
            variant="email"
            label={t.formEmail}
            name="email"
            maxlength={200}
            required
            labelHidden
          />
          <Textarea
            label={t.formMessage}
            name="message"
            placeholder={t.formMessage}
            minLines={1}
            maxlength={5000}
            required
            labelHidden
          />
          <div class="sr-only" aria-hidden="true">
            <label>
              Web
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>
          <div class="form_row">
            <Choice
              label={t.formConsent}
              name="consent"
              variant="round"
              required
            />
            <Button variant="link" type="submit">
              {t.formSubmit}
            </Button>
          </div>
          {turnstileKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileKey}
              data-language={lang}
              data-appearance="interaction-only"
            />
          )}
        </Form>
      </div>
    </ContentWrapper>

    <!-- The arcades under the form, the horns of plenty beside them -->
    <div class="contact_closing">
      <div class="contact_photo">
        <Img
          src={arcade}
          alt={t.contactPhotoAlt}
          variant="constrained"
          sizes="(width >= 48rem) 41rem, 100vw"
        />
      </div>
      <img
        class="contact_ornament"
        src={hornsOfPlenty.src}
        width="147"
        height="92"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </Section>

  <style is:global>
    /* The contact people: one block of body text, the heading line in semibold. */
    .contact_people {
      margin-top: clamp(4rem, 6.04vw, 7.25rem);
      font-size: var(--text-main);
      line-height: 1.4;
    }

    .contact_people_title {
      margin: 0;
      font: inherit;
      font-weight: var(--primary-semibold);
      letter-spacing: var(--letter-spacing-wide);
    }

    .contact_people_list {
      margin: 0;
      padding: 0;
      list-style: none;
      letter-spacing: var(--letter-spacing-wide);
    }

    /* The form is 637px wide at 1920, set to the right edge of its column. */
    .contact_form_wrap {
      width: 100%;
      max-width: 39.8125rem;
      align-self: end;
    }

    /*
     * As the design closes the page at 1920: the arcades (641 × 893) under
     * the form, 158px below its link and 258px above the footer's rule, and
     * the pale horns of plenty at the left, reaching 48px below the
     * photograph. The client asked for the
     * engraving a little smaller than the design's 596px: 520px.
     */
    .contact_closing {
      display: grid;
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-6);
      margin-block: 4rem clamp(2.5rem, 0.8118rem + 6.719vw, 8.875rem);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--site-gutter);
      }
    }

    .contact_photo {
      width: 100%;
      @media (width >= 48rem) {
        grid-column: 2;
        grid-row: 1;
        justify-self: end;
        max-width: 40.0625rem;
      }

      & > .image {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 641 / 893;
        object-fit: cover;
      }
    }

    .contact_ornament {
      width: clamp(14rem, 27.0833vw, 32.5rem);
      height: auto;
      opacity: 0.08;
      user-select: none;
      pointer-events: none;
      @media (width >= 48rem) {
        grid-column: 1;
        grid-row: 1;
        align-self: end;
        margin-bottom: calc(-1 * clamp(1rem, 2.5vw, 3rem));
      }
    }
  </style>

  {turnstileKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )}
</Layout>
