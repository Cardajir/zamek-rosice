---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Heading from "@/components/typography/Heading.astro";
import GalleryEventsMain from "@/components/content/GalleryEventsMain.astro";
import GalleryNavMain from "@/components/content/GalleryNavMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getAlbums, getEventAlbums } from "@/sanity/page-queries.ts";
import { EVENTS, galleryNav } from "@/utils/gallery.ts";
import { sanitySocialImage } from "@/utils/seo.ts";
import { parseVideo, youtubeThumbnail } from "@/utils/video.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const [albums, events] = await Promise.all([
  getAlbums(lang),
  getEventAlbums(lang),
]);

const still = (url?: string) => {
  const video = parseVideo(url);
  return video && youtubeThumbnail(video);
};
---

<Layout
  title={`${t.galleryEvents} – ${t.galleryTitle}`}
  description={t.metaGalleryEvents}
  image={sanitySocialImage(events[0]?.cover)}
  pageType="ImageGallery"
  alternates={alternates("galleryEvents")}
  breadcrumbs={[{ name: t.galleryTitle, path: routePath("gallery", lang) }]}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.galleryTitle} />
  </Section>

  <!-- Albums -->
  <Section id="alba" paddingTop="none" paddingBottom="none">
    <GalleryNavMain
      label={t.galleryAlbums}
      intro={t.galleryIntro}
      items={galleryNav(albums, lang, EVENTS)}
    />
  </Section>

  <!-- Albums from events, newest first -->
  <Section paddingTop="large" paddingBottom="none" gap="0">
    <Heading tag="h2" class="sr-only">{t.galleryEvents}</Heading>
    <GalleryEventsMain
      items={events.map((album) => ({
        title: album.title,
        href: `${routePath("gallery", lang, album.slug)}#fotky`,
        date: album.eventDate,
        image: album.cover,
        poster: album.cover ? undefined : still(album.video),
      }))}
      empty={t.galleryEventsEmpty}
      back="#alba"
      id="fotky"
    />
  </Section>
</Layout>
