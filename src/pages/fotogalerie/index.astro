---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import GalleryMain from "@/components/content/GalleryMain.astro";
import GalleryNavMain from "@/components/content/GalleryNavMain.astro";
import StatusBarMain from "@/components/content/StatusBarMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getAlbums } from "@/sanity/page-queries.ts";
import { shellFor } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);

const [shell, albums] = await Promise.all([
  shellFor(Astro.locals),
  getAlbums(lang),
]);

/* The front page shows the first photographs of every album. */
const selection = albums.flatMap((album) => album.images);
---

<Layout
  title={t.galleryTitle}
  description={t.galleryIntro}
  alternates={alternates("gallery")}
>
  <!-- Status bar -->
  <Section paddingTop="none" paddingBottom="small">
    <StatusBarMain shell={shell} />
  </Section>

  <!-- Title -->
  <Section paddingTop="small" paddingBottom="small">
    <ContentWrapper centered>
      <Heading tag="h1">{t.galleryTitle}</Heading>
    </ContentWrapper>
  </Section>

  <!-- Albums -->
  <Section
    render={albums.length > 0}
    paddingTop="small"
    paddingBottom="small"
    gap="4"
    align="center"
  >
    <Ornament variant={6} />
    <Eyebrow>{t.galleryIntro}</Eyebrow>
    <GalleryNavMain
      label={t.galleryAlbums}
      items={[
        {
          label: t.selectedPhotos,
          href: routePath("gallery", lang),
          current: true,
        },
        ...albums.map((album) => ({
          label: album.title,
          href: routePath("gallery", lang, album.slug),
        })),
      ]}
    />
  </Section>

  <!-- Selected photographs -->
  <Section render={selection.length > 0} paddingTop="small" gap="5">
    <Heading tag="h2" variant="h5">
      {t.selectedPhotos}
    </Heading>
    <GalleryMain photos={selection} />
  </Section>
</Layout>
