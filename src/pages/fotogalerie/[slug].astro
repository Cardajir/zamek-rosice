---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Heading from "@/components/typography/Heading.astro";
import GalleryMain from "@/components/content/GalleryMain.astro";
import GalleryNavMain from "@/components/content/GalleryNavMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getAlbum, getAlbums } from "@/sanity/page-queries.ts";
import { fillIn, sanitySocialImage } from "@/utils/seo.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const album = await getAlbum(lang, Astro.params.slug ?? "");

if (!album || album.images.length === 0) return Astro.rewrite("/404/");

const albums = await getAlbums(lang);

/* The first album is the gallery's front page; its own address leads there. */
if (albums[0]?.slug === album.slug) {
  return Astro.redirect(routePath("gallery", lang), 301);
}

const cover = album.images[0];
---

<Layout
  title={`${album.title} – ${t.galleryTitle}`}
  description={fillIn(t.metaAlbum, { album: album.title })}
  image={sanitySocialImage(cover)}
  pageType="ImageGallery"
  alternates={alternates("gallery", album.slugs)}
  breadcrumbs={[{ name: t.galleryTitle, path: routePath("gallery", lang) }]}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.galleryTitle} />
  </Section>

  <!-- Albums -->
  <Section id="alba" paddingTop="none" paddingBottom="none">
    <GalleryNavMain
      label={t.galleryAlbums}
      intro={t.galleryIntro}
      items={albums.map((item, index) => ({
        label: item.title,
        href: `${
          index === 0
            ? routePath("gallery", lang)
            : routePath("gallery", lang, item.slug)
        }#fotky`,
        current: item.slug === album.slug,
      }))}
    />
  </Section>

  <!-- Photographs -->
  <Section paddingTop="large" paddingBottom="none" gap="0">
    <Heading tag="h2" class="sr-only">
      {album.title}
    </Heading>
    <GalleryMain photos={album.images} back="#alba" id="fotky" />
  </Section>
</Layout>
