---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import PageHeroMain from "@/components/content/PageHeroMain.astro";
import Heading from "@/components/typography/Heading.astro";
import GalleryEventMain from "@/components/content/GalleryEventMain.astro";
import GalleryMain from "@/components/content/GalleryMain.astro";
import GalleryNavMain from "@/components/content/GalleryNavMain.astro";
import { DEFAULT_LANG } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getAlbum, getAlbums } from "@/sanity/page-queries.ts";
import { EVENTS, galleryNav } from "@/utils/gallery.ts";
import { fillIn, sanitySocialImage } from "@/utils/seo.ts";
import { parseVideo, youtubeThumbnail } from "@/utils/video.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const album = await getAlbum(lang, Astro.params.slug ?? "");

const isEvent = album?.category === "events";
if (
  !album ||
  (album.images.length === 0 && !(isEvent && album.videos.length > 0))
) {
  return Astro.rewrite("/404/");
}

const albums = await getAlbums(lang);

/* The first album is the gallery's front page; its own address leads there. */
if (!isEvent && albums[0]?.slug === album.slug) {
  return Astro.redirect(routePath("gallery", lang), 301);
}

/* Shared as its first photograph, or a still from its first video. */
const still = album.videos
  .map((video) => parseVideo(video.url))
  .map((video) => video && youtubeThumbnail(video))
  .find(Boolean);
const image =
  sanitySocialImage(album.images[0]) ??
  (still ? { src: still, width: 480, height: 360 } : undefined);

const events = routePath("galleryEvents", lang);
---

<Layout
  title={`${album.title} – ${t.galleryTitle}`}
  description={fillIn(isEvent ? t.metaEventAlbum : t.metaAlbum, {
    album: album.title,
  })}
  image={image}
  pageType="ImageGallery"
  alternates={alternates("gallery", album.slugs)}
  breadcrumbs={[
    { name: t.galleryTitle, path: routePath("gallery", lang) },
    ...(isEvent ? [{ name: t.galleryEvents, path: events }] : []),
  ]}
>
  <!-- Photograph and title -->
  <Section paddingTop="none" paddingBottom="none">
    <PageHeroMain title={t.galleryTitle} />
  </Section>

  <!-- Albums -->
  <Section id="alba" paddingTop="none" paddingBottom="none">
    <GalleryNavMain
      label={t.galleryAlbums}
      intro={t.galleryIntro}
      items={galleryNav(albums, lang, isEvent ? EVENTS : album.slug)}
    />
  </Section>

  <!-- Name, day and videos of an event, then the photographs -->
  <Section paddingTop="large" paddingBottom="none" gap="0">
    <Heading tag="h2" class="sr-only" render={!isEvent}>
      {album.title}
    </Heading>
    <GalleryEventMain
      title={isEvent ? album.title : undefined}
      date={isEvent ? album.eventDate : undefined}
      videos={album.videos}
      back={album.images.length === 0 ? `${events}#fotky` : undefined}
      id={isEvent ? "fotky" : undefined}
    />
    <GalleryMain
      photos={album.images}
      back={isEvent ? `${events}#fotky` : "#alba"}
      id={isEvent ? undefined : "fotky"}
    />
  </Section>
</Layout>
