---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import SanityImg from "@/components/media/SanityImg.astro";
import Parallax from "@/components/media/Parallax.astro";
import EventsMain from "@/components/content/EventsMain.astro";
import ToursMain from "@/components/content/ToursMain.astro";
import StatusBarMain from "@/components/content/StatusBarMain.astro";
import RatingMain from "@/components/content/RatingMain.astro";
import PromoMain from "@/components/content/PromoMain.astro";
import QuoteMain from "@/components/content/QuoteMain.astro";
import { DEFAULT_LANG, LANG_LOCALES } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getHome, shellFor } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const locale = LANG_LOCALES[lang];

const [shell, home] = await Promise.all([
  shellFor(Astro.locals),
  getHome(lang),
]);

const fullDate = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout alternates={alternates("home")} data-stacki-key="k35k3zr3zntn9">
  <!-- Hero photograph and status bar -->
  <Section paddingTop="none" paddingBottom="small" gap="3" class="home_hero">
    {home.heroImage && (
      <Parallax>
        <SanityImg
          image={home.heroImage}
          ratio={7 / 3}
          narrowRatio={1}
          loading="eager"
          fetchPriority="high"
          data-stacki-key="kqcjjl4yu46m6"
        />
      </Parallax>
    )}
    <StatusBarMain shell={shell} data-stacki-key="kj3d8mvtcsp9m" />
  </Section>

  <!-- Heading -->
  <Section paddingTop="small">
    <ContentWrapper centered class="home_intro">
      <Ornament variant={1} />
      <Heading tag="h1" maxWidth={22} data-stacki-key="koa1jvho7v6wm">
        {home.heading ?? t.siteTagline}
      </Heading>
      <ButtonWrapper>
        <Button
          render={Boolean(home.headingLink)}
          element="link"
          variant="link"
          href={home.headingLink?.href}
        >
          {home.headingLink?.label}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Upcoming events -->
  <Section render={home.posts.length > 0} gap="5" class="home_events">
    <EventsMain
      posts={home.posts}
      heading={t.upcomingEvents}
      data-stacki-key="k5sx4lf6l3vmv"
    />
    <ButtonWrapper>
      <Button element="link" variant="link" href={routePath("news", lang)}>
        {t.allEvents}
      </Button>
    </ButtonWrapper>
  </Section>

  <!-- Tours and permanent exhibitions -->
  <Section
    render={home.tours.length > 0}
    gap="4"
    class="home_tours"
    data-stacki-key="kbgpiynhcyjom"
  >
    <Heading tag="h2" variant="h5">
      {t.toursHeading}
    </Heading>
    <ToursMain tours={home.tours} />
    <ButtonWrapper>
      <Button element="link" variant="link" href={routePath("tours", lang)}>
        {t.allTours}
      </Button>
    </ButtonWrapper>
  </Section>

  <!-- Heritage note, rating and status -->
  <Section
    paddingTop="small"
    paddingBottom="small"
    gap="3"
    class="home_heritage"
  >
    {home.secondImage && (
      <Parallax>
        <SanityImg
          image={home.secondImage}
          ratio={7 / 3}
          narrowRatio={370 / 252}
        />
      </Parallax>
    )}
    <StatusBarMain shell={shell} note={home.heritageNote}>
      <RatingMain
        slot="center"
        value={shell.rating?.value}
        label={shell.rating?.label}
        source={shell.rating?.source}
        href={shell.rating?.url}
      />
    </StatusBarMain>
  </Section>

  <!-- Weddings, the Šenk hall, school trips -->
  <Section
    render={home.promos.length > 0}
    gap="large"
    class="home_promos"
    data-stacki-key="k539eip7f0rga"
  >
    {home.promos.map((promo, index) => (
      <PromoMain
        promo={promo}
        reverse={index % 2 === 1}
        backdrop={index === 1}
        data-stacki-key="k03odtz2ndt5b"
      />
    ))}
  </Section>

  <!-- Visitor's quote -->
  <Section render={Boolean(home.quote)} gap="7" data-stacki-key="kfefupshi3d7c">
    <Ornament variant={2} />
    <QuoteMain
      text={home.quote?.text}
      author={home.quote?.author}
      date={
        home.quote?.date &&
        fullDate.format(new Date(`${home.quote.date}T00:00:00Z`))
      }
      data-stacki-key="k14juthpdlpgt"
    />
  </Section>
</Layout>

<style is:global>
  /* On a phone the photograph sits 8px above the status bar’s rule. */
  @media (width < 48rem) {
    .home_hero > .container,
    .home_heritage > .container {
      row-gap: 0.5rem;
    }
    /*
     * The promos as the phone design spaces them: 148px under the rating,
     * 147px from one link to the next photographs, 173px before a pair that
     * starts at the page’s edge.
     */
    .home_promos.section {
      padding-top: calc(var(--section-space-medium) + 2.25rem);
    }
    .home_promos > .container {
      row-gap: 9.1875rem;
    }
    .home_promos .promo_wrap.reverse {
      margin-top: 1.625rem;
    }

    /* 88px from the status bar to the ornament. */
    .home_hero.section {
      padding-bottom: 2.3125rem;
    }
  }

  /* 61px above and below the opening line, as the design spaces it at 1920. */
  .home_intro {
    --_gap: clamp(2.5rem, 3.18vw, 3.8125rem);
    & .ornament_wrap {
      margin-bottom: var(--_gap);
    }
    & h1 {
      margin-block: 0;
      /* On a phone the line keeps 32px from either edge. */
      @media (width < 48rem) {
        padding-inline: 1rem;
      }
    }
    & .button-wrapper {
      margin-top: var(--_gap);
    }
  }

  /* 64px from the last row of tours to the link, the arrow's line box included. */
  /* On a phone the link lines up with the cards’ text. */
  .home_events .button-wrapper {
    @media (width < 48rem) {
      margin-top: -1.3125rem;
      padding-left: 1rem;
    }
  }

  .home_tours .tours_wrap + .button-wrapper {
    margin-top: calc(var(--space-8) - var(--space-4) - 0.6rem);
    /* On a phone: 77px under the last rule, in line with the cards’ text. */
    @media (width < 48rem) {
      margin-top: calc(var(--space-8) - var(--space-4) - 0.6rem + 0.875rem);
      padding-left: 1rem;
    }
  }
</style>
