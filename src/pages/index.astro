---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Ornament from "@/components/media/Ornament.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import SanityImg from "@/components/media/SanityImg.astro";
import EventsMain from "@/components/content/EventsMain.astro";
import ToursMain from "@/components/content/ToursMain.astro";
import StatusBarMain from "@/components/content/StatusBarMain.astro";
import RatingMain from "@/components/content/RatingMain.astro";
import PromoMain from "@/components/content/PromoMain.astro";
import QuoteMain from "@/components/content/QuoteMain.astro";
import { DEFAULT_LANG, LANG_LOCALES } from "@/consts.ts";
import { alternates, routePath } from "@/i18n/routes.ts";
import { ui } from "@/i18n/ui.ts";
import { getHome, shellFor } from "@/sanity/queries.ts";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = ui(lang);
const locale = LANG_LOCALES[lang];

const [shell, home] = await Promise.all([
  shellFor(Astro.locals),
  getHome(lang),
]);

const fullDate = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout alternates={alternates("home")}>
  <!-- Hero photograph and status bar -->
  <Section paddingTop="none" paddingBottom="small" gap="3">
    {home.heroImage && (
      <SanityImg
        image={home.heroImage}
        ratio={7 / 3}
        loading="eager"
        fetchPriority="high"
      />
    )}
    <StatusBarMain shell={shell} />
  </Section>

  <!-- Heading -->
  <Section paddingTop="small">
    <ContentWrapper centered>
      <Ornament variant={1} class="margin-bottom-7" />
      <Heading tag="h1" maxWidth={22}>
        {home.heading ?? t.siteTagline}
      </Heading>
      <ButtonWrapper>
        <Button
          render={Boolean(home.headingLink)}
          element="link"
          variant="link"
          href={home.headingLink?.href}
        >
          {home.headingLink?.label}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Upcoming events -->
  <Section render={home.posts.length > 0} gap="5">
    <Heading tag="h2" variant="h5">
      {t.upcomingEvents}
    </Heading>
    <EventsMain posts={home.posts} />
    <ButtonWrapper>
      <Button element="link" variant="link" href={routePath("news", lang)}>
        {t.allEvents}
      </Button>
    </ButtonWrapper>
  </Section>

  <!-- Tours and permanent exhibitions -->
  <Section render={home.tours.length > 0} gap="4">
    <Heading tag="h2" variant="h5">
      {t.toursHeading}
    </Heading>
    <ToursMain tours={home.tours} />
    <ButtonWrapper>
      <Button element="link" variant="link" href={routePath("tours", lang)}>
        {t.allTours}
      </Button>
    </ButtonWrapper>
  </Section>

  <!-- Heritage note, rating and status -->
  <Section paddingTop="small" paddingBottom="small" gap="3">
    {home.secondImage && <SanityImg image={home.secondImage} ratio={7 / 3} />}
    <StatusBarMain shell={shell} note={home.heritageNote}>
      <RatingMain
        slot="center"
        value={shell.rating?.value}
        label={shell.rating?.label}
        source={shell.rating?.source}
        href={shell.rating?.url}
      />
    </StatusBarMain>
  </Section>

  <!-- Weddings, the Šenk hall, school trips -->
  <Section render={home.promos.length > 0} gap="large">
    {home.promos.map((promo, index) => (
      <PromoMain promo={promo} reverse={index % 2 === 1} />
    ))}
  </Section>

  <!-- Visitor's quote -->
  <Section render={Boolean(home.quote)} gap="7">
    <Ornament variant={2} />
    <QuoteMain
      text={home.quote?.text}
      author={home.quote?.author}
      date={
        home.quote?.date &&
        fullDate.format(new Date(`${home.quote.date}T00:00:00Z`))
      }
    />
  </Section>
</Layout>
